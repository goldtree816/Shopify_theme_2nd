<style>
    body{
  font-family: var(--font-primary--family);
  padding-top:70px;
}

body:not(.template-index) .navbar {
  background-color: var(--color-background);
  position: relative;
  border-bottom: 1px solid var(--color-border);
}

body:not(.template-index) .top-banner {
  background-color: var(--color-accent);
  color: var(--color-accent-contrast);
  position: relative;
}

body:not(.template-index) .navbar a{
  color: var(--color-link);
}

</style>

<div class="aevi-account-wrapper">

  <h2 class="aevi-welcome">Welcome, {{ customer.first_name }}</h2>

  <div class="aevi-account-layout">

    <div class="aevi-account-sidebar">
      <a href="#" class="active">Contact information</a>
      <a href="{{ routes.account_addresses_url }}">Addresses</a>
      <a href="{{ routes.account_url }}">Orders</a>
      <a href="{{ routes.account_logout_url }}">Sign out</a>
    </div>

    <div class="aevi-account-content">
      <h3>CONTACT INFORMATION</h3>
      <p><strong>Name</strong><br>{{ customer.first_name }} {{ customer.last_name }}</p>
      <p><strong>Email</strong><br>{{ customer.email }}</p>

    <a
      href="#"
      data-action="open-drawer"
      data-toggle-id="Drawer"
      data-drawer-source="#edit-default-address"
      data-drawer-title="Edit address"
    >
      Edit
    </a>

    </div>

  </div>

</div>

{% if customer.default_address %}
  <div id="edit-default-address" hidden>
    {% form 'customer_address', customer.default_address, return_to: routes.account_url %}

      <input
        type="text"
        name="address[first_name]"
        value="{{ customer.default_address.first_name }}"
      >

      <input
        type="text"
        name="address[last_name]"
        value="{{ customer.default_address.last_name }}"
      >

      <input
        type="text"
        name="address[address1]"
        value="{{ customer.default_address.address1 }}"
        required
      >

      <input
        type="text"
        name="address[city]"
        value="{{ customer.default_address.city }}"
      >

      <input
        type="text"
        name="address[zip]"
        value="{{ customer.default_address.zip }}"
      >

      <input
        type="hidden"
        name="address[country]"
        value="{{ customer.default_address.country }}"
      >

      <button type="submit">
        Update address
      </button>

    {% endform %}
  </div>
{% endif %}
