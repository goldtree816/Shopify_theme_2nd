<div class="aevi-auth-wrapper">

  <h1 class="aevi-title">FORGOT PASSWORD</h1>
  <p class="aevi-subtitle">
    Input your email address and we will send you a link to restore the password.
  </p>

  {% form 'recover_customer_password' %}
    {% if form.errors %}
      <p class="aevi-error">{{ form.errors | default_errors }}</p>
    {% endif %}

    <label>Email</label>
    <input type="email" name="email" required>

    <button class="aevi-button">Send</button>
  {% endform %}

  <p class="aevi-bottom-text">
    Remember your password?
    <a href="{{ routes.account_login_url }}">Log in</a>
  </p>

</div>
