<style>
html {
  overflow-x: hidden;
}

body {
  font-family: 'Manrope', sans-serif;
}

/* ================= TOP BANNER ================= */
.top-banner {
  position: relative;
  width: 100vw;
  text-align: center;
  font-size: var(--banner-text-size);
  font-weight: 600;
  color: var(--banner-text-color);
  min-height: var(--banner-height);
  padding: 4px 16px;
  border-bottom: 1px solid rgba(255,255,255,0.2);
  background-color: {{ section.settings.banner_bg_color }};
  transition: height 0.25s ease, padding 0.25s ease, opacity 0.25s ease;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  --banner-height: {{ section.settings.banner_height | default: 36 }}px;
  --banner-height-mobile: {{ section.settings.banner_height_mobile | default: 32 }}px;
  --banner-text-size: {{ section.settings.banner_text_size | default: 13 }}px;
  --banner-text-size-mobile: {{ section.settings.banner_text_size_mobile | default: 12 }}px;
  --banner-text-color: {{ section.settings.banner_text_color | default: '#ffffff' }};
  --banner-transition: {{ section.settings.banner_transition_ms | default: 600 }}ms;
}

header:hover .top-banner {
  background-color: {{ section.settings.banner_hover_bg_color | default: '#a3bfdb' }};
  color: {{ section.settings.banner_hover_text_color | default: '#1d3d7a' }};
  border-bottom: 1px solid rgba(0,0,0,0.2);
}

header:hover .top-banner a {
  color: {{ section.settings.banner_hover_link_color | default: '#1d3d7a' }};
}

.top-banner__viewport {
  width: 100%;
  overflow: hidden;
}

.top-banner__track {
  display: flex;
  flex-direction: column;
  transform: translateY(0);
  transition: transform var(--banner-transition) cubic-bezier(0.2, 0.7, 0, 1);
  will-change: transform;
}

.top-banner__item {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  min-height: var(--banner-height);
  line-height: 1.3;
  padding: 2px 0;
}

.top-banner__text {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.top-banner__link {
  color: {{ section.settings.banner_link_color }};
  text-decoration: underline;
  text-underline-offset: 2px;
  white-space: nowrap;
}

/* ================= NAVBAR ================= */
.navbar {
  width: 100%;
  background-color: transparent;
  padding: {{ section.settings.navbar_height }}px 40px;
  position: relative;
  z-index: 1000;
  transition: background-color 0.25s ease, box-shadow 0.25s ease;
}

.navbar-inner {
  max-width: 1400px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
}

/* Hover / scroll background */
header:hover .navbar:hover,
.navbar.scrolled {
  background-color: white;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

.navbar.scrolled a {
  color: black;
}

.navbar:hover a {
  color: black;
}

/* ================= NAV GROUPS ================= */
.nav-left,
.nav-right {
  display: flex;
  align-items: center;
  gap: {{ section.settings.nav_item_spacing }}px;
  font-size: {{ section.settings.nav_font_size }}px;
}

/* Center logo */
.nav-center {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  --logo-width: {{ section.settings.logo_width | default: 140 }}px;
  --logo-width-mobile: {{ section.settings.logo_width_mobile | default: 110 }}px;
  --logo-height: {{ section.settings.logo_height | default: 44 }}px;
}

.nav-center a {
  color: white;
  font-size: {{ section.settings.logo_font_size }}px;
  text-decoration: none;
}

.nav-logo {
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.nav-logo img {
  display: block;
  width: auto;
  height: auto;
  max-width: var(--logo-width);
  max-height: var(--logo-height);
}

.nav-center .logo-scrolled {
  display: none;
}

.nav-center.has-alt-logo .logo-scrolled {
  display: none;
}

.navbar.scrolled .nav-center.has-alt-logo .logo-default,
.navbar:hover .nav-center.has-alt-logo .logo-default {
  display: none;
}

.navbar.scrolled .nav-center.has-alt-logo .logo-scrolled,
.navbar:hover .nav-center.has-alt-logo .logo-scrolled {
  display: block;
}

.nav-center .logo-text {
  font-size: {{ section.settings.logo_font_size }}px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.navbar.scrolled .nav-center .logo-text,
.navbar:hover .nav-center .logo-text {
  color: black;
}

@media (max-width: 768px) {
  .nav-logo img {
    max-width: var(--logo-width-mobile);
  }
}

@media (max-width: 640px) {
  .top-banner {
    min-height: var(--banner-height-mobile);
    font-size: var(--banner-text-size-mobile);
  }
}

.navbar.scrolled .nav-center a,
.navbar:hover .nav-center a {
  color: black;
}

/* Links */
.navbar a {
  color: white;
  text-decoration: none;
  transition: color 0.25s ease;
}

.navbar a:hover {
  text-decoration: underline;
}

/* Icons */
.nav-right svg {
  width: 26px;
  height: 26px;
}

/* ================= DROPDOWN ================= */
.nav-item {
  position: relative;
}

.dropdown-menu {
  position: fixed;
  left: 0;
  width: 100vw;
  padding: 30px 120px;
  background: white;
  opacity: 0;
  visibility: hidden;
  transform: translateY(-20px);
  transition: opacity 0.35s ease, transform 0.35s ease;
  pointer-events: none;
  z-index: 999;
}

.nav-item:hover .dropdown-menu {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
  pointer-events: auto;
}

.dropdown-content {
  display: flex;
  gap: 80px;
}

.dropdown-columns {
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.dropdown-columns ul {
  list-style: none;
  padding: 0;
}

.dropdown-columns a {
  color: black;
  font-size: 14px;
}

.dropdown-images {
  display: flex;
  gap: 20px;
  width: 750px;
}

.dropdown-images img {
  width: 50%;
  height: 600px;
  object-fit: cover;
}

/* ================= SCROLL BEHAVIOR ================= */
/* ONLY banner collapses – navbar height stays same */
#site-header.is-scrolled .top-banner {
  height: 0;
  min-height: 0;
  padding: 0;
  opacity: 0;
  border: none;
}
</style>

<header id="site-header" class="fixed top-0 left-0 w-full z-50">

  {% assign banner_blocks = section.blocks | where: 'type', 'banner_item' %}
  {% if section.settings.banner_enable %}
    <!-- TOP BANNER -->
    <div
      class="top-banner"
      data-autoplay="{{ section.settings.banner_autoplay }}"
      data-interval="{{ section.settings.banner_interval }}"
      data-transition="{{ section.settings.banner_transition_ms }}"
      data-pause-on-hover="{{ section.settings.banner_pause_on_hover }}"
    >
      <div class="top-banner__viewport">
        <div class="top-banner__track">
          {% if banner_blocks.size > 0 %}
            {% for block in banner_blocks %}
              <div class="top-banner__item" {{ block.shopify_attributes }}>
                {% if block.settings.text != blank %}
                  <span class="top-banner__text">{{ block.settings.text }}</span>
                {% endif %}
                {% if block.settings.link_label != blank %}
                  {% if block.settings.link != blank %}
                    <a class="top-banner__link" href="{{ block.settings.link }}">
                      {{ block.settings.link_label }}
                    </a>
                  {% else %}
                    <span class="top-banner__link">{{ block.settings.link_label }}</span>
                  {% endif %}
                {% endif %}
              </div>
            {% endfor %}
          {% else %}
            <div class="top-banner__item">
              {% if section.settings.banner_text != blank %}
                <span class="top-banner__text">{{ section.settings.banner_text }}</span>
              {% endif %}
              {% if section.settings.banner_link_label != blank %}
                {% if section.settings.banner_link != blank %}
                  <a class="top-banner__link" href="{{ section.settings.banner_link }}">
                    {{ section.settings.banner_link_label }}
                  </a>
                {% else %}
                  <span class="top-banner__link">{{ section.settings.banner_link_label }}</span>
                {% endif %}
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  {% endif %}

  <!-- NAVBAR -->
  <div class="navbar" id="navbar">
    <div class="navbar-inner">

      <!-- LEFT -->
      <nav class="nav-left">
        {% for link in linklists[section.settings.left-navbar].links %}
          <div class="nav-item">
            <a href="{{ link.url }}">{{ link.title }}</a>

            {% if link.links != blank %}
              <div class="dropdown-menu">
                <div class="dropdown-content">
                  <div class="dropdown-columns">
                    {% for child in link.links %}
                      <ul>
                        <li><strong>{{ child.title }}</strong></li>
                        {% for sub in child.links %}
                          <li><a href="{{ sub.url }}">{{ sub.title }}</a></li>
                        {% endfor %}
                      </ul>
                    {% endfor %}
                  </div>

                  <div class="dropdown-images">
                    {% for block in section.blocks %}
                      {% if block.settings.menu_title == link.title %}
                        {% if block.settings.image_1 %}
                          <img src="{{ block.settings.image_1 | image_url }}">
                        {% endif %}
                        {% if block.settings.image_2 %}
                          <img src="{{ block.settings.image_2 | image_url }}">
                        {% endif %}
                      {% endif %}
                    {% endfor %}
                  </div>
                </div>
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </nav>

      <!-- CENTER -->
      <div class="nav-center {% if section.settings.logo_image_scrolled != blank %}has-alt-logo{% endif %}">
        <a href="{{ routes.root_url }}" class="nav-logo" aria-label="{{ shop.name }}">
          {% if section.settings.logo_image != blank %}
            <img class="logo-default" src="{{ section.settings.logo_image | image_url: width: 400 }}" alt="{{ section.settings.logo_image.alt | default: shop.name }}">
            {% if section.settings.logo_image_scrolled != blank %}
              <img class="logo-scrolled" src="{{ section.settings.logo_image_scrolled | image_url: width: 400 }}" alt="{{ section.settings.logo_image_scrolled.alt | default: shop.name }}">
            {% endif %}
          {% elsif settings.logo != blank %}
            <img class="logo-default" src="{{ settings.logo | image_url: width: 400 }}" alt="{{ shop.name }}">
          {% elsif shop.brand.logo != blank %}
            <img class="logo-default" src="{{ shop.brand.logo | image_url: width: 400 }}" alt="{{ shop.name }}">
          {% else %}
            <span class="logo-text">{{ shop.name }}</span>
          {% endif %}
        </a>
      </div>

      <!-- RIGHT -->
      <nav class="nav-right">
        {% for link in linklists[section.settings.right-navbar].links %}
          {% case link.title %}
            {% when "CART" %}
              <a href="#" class="open-cart-drawer">{% render 'icon-shopping-bag' %}</a>
            {% when "SEARCH" %}
              <a href="/search">{% render 'icon-search' %}</a>
            {% when "PROFILE" %}
              <a href="/account">{% render 'icon-profile' %}</a>
            {% else %}
              <a href="{{ link.url }}">{{ link.title }}</a>
          {% endcase %}
        {% endfor %}
      </nav>

    </div>
  </div>
</header>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const banner = document.querySelector(".top-banner");
  if (banner) {
    const track = banner.querySelector(".top-banner__track");
    if (track) {
      const items = Array.from(track.children);
      const count = items.length;
      const autoplay = banner.dataset.autoplay === "true";
      const pauseOnHover = banner.dataset.pauseOnHover === "true";
      const interval = Number(banner.dataset.interval) || 4000;
      const transition = Number(banner.dataset.transition) || 600;
      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (count > 1 && autoplay && !prefersReducedMotion) {
        const firstClone = items[0].cloneNode(true);
        firstClone.setAttribute("aria-hidden", "true");
        track.appendChild(firstClone);

        let index = 0;
        let timer = null;
        let itemHeight = banner.clientHeight;

        const updateHeight = () => {
          itemHeight = banner.clientHeight;
          track.style.transform = `translateY(-${index * itemHeight}px)`;
        };

        const moveTo = (i) => {
          track.style.transition = `transform ${transition}ms cubic-bezier(0.2, 0.7, 0, 1)`;
          track.style.transform = `translateY(-${i * itemHeight}px)`;
        };

        const next = () => {
          index += 1;
          moveTo(index);
        };

        track.addEventListener("transitionend", () => {
          if (index === count) {
            track.style.transition = "none";
            index = 0;
            track.style.transform = "translateY(0)";
            void track.offsetHeight;
          }
        });

        const stop = () => {
          if (timer) {
            clearInterval(timer);
            timer = null;
          }
        };

        const start = () => {
          if (timer) return;
          timer = setInterval(next, interval);
        };

        updateHeight();
        window.addEventListener("resize", updateHeight);
        start();

        if (pauseOnHover) {
          banner.addEventListener("mouseenter", stop);
          banner.addEventListener("mouseleave", start);
          banner.addEventListener("focusin", stop);
          banner.addEventListener("focusout", start);
        }
      }
    }
  }

  const header = document.getElementById("site-header");
  const navbar = document.getElementById("navbar");

  function onScroll() {
    if (window.scrollY > 10) {
      header.classList.add("is-scrolled");
      navbar.classList.add("scrolled");
    } else {
      header.classList.remove("is-scrolled");
      navbar.classList.remove("scrolled");
    }
  }

  window.addEventListener("scroll", onScroll);
  onScroll();
});
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "checkbox", "id": "banner_enable", "label": "Enable top banner", "default": true },
    { "type": "text", "id": "banner_text", "label": "Banner text", "default": "FREE SHIPPING" },
    { "type": "text", "id": "banner_link_label", "label": "Banner link label", "default": "SHOP NOW" },
    { "type": "url", "id": "banner_link", "label": "Banner link" },
    { "type": "color", "id": "banner_bg_color", "label": "Banner background", "default": "#2A3C2D" },
    { "type": "color", "id": "banner_text_color", "label": "Banner text color", "default": "#FFFFFF" },
    { "type": "color", "id": "banner_link_color", "label": "Banner link color", "default": "#FFFFFF" },
    { "type": "color", "id": "banner_hover_bg_color", "label": "Banner hover background", "default": "#A3BFDB" },
    { "type": "color", "id": "banner_hover_text_color", "label": "Banner hover text color", "default": "#1D3D7A" },
    { "type": "color", "id": "banner_hover_link_color", "label": "Banner hover link color", "default": "#1D3D7A" },
    { "type": "range", "id": "banner_height", "label": "Banner height", "min": 24, "max": 60, "step": 2, "default": 36 },
    { "type": "range", "id": "banner_height_mobile", "label": "Banner height (mobile)", "min": 24, "max": 56, "step": 2, "default": 32 },
    { "type": "range", "id": "banner_text_size", "label": "Banner text size", "min": 10, "max": 20, "step": 1, "default": 13 },
    { "type": "range", "id": "banner_text_size_mobile", "label": "Banner text size (mobile)", "min": 10, "max": 18, "step": 1, "default": 12 },
    { "type": "checkbox", "id": "banner_autoplay", "label": "Banner autoplay", "default": true },
    { "type": "range", "id": "banner_interval", "label": "Banner rotation interval (ms)", "min": 2000, "max": 8000, "step": 500, "default": 4000 },
    { "type": "range", "id": "banner_transition_ms", "label": "Banner transition duration (ms)", "min": 300, "max": 1200, "step": 50, "default": 600 },
    { "type": "checkbox", "id": "banner_pause_on_hover", "label": "Pause rotation on hover", "default": true },
    { "type": "link_list", "id": "left-navbar", "label": "Left menu" },
    { "type": "link_list", "id": "right-navbar", "label": "Right menu" },
    { "type": "range", "id": "nav_item_spacing", "label": "Item spacing", "min": 0, "max": 50, "step": 1, "default": 20 },
    { "type": "range", "id": "nav_font_size", "label": "Font size", "min": 10, "max": 24, "step": 1, "default": 14 },
    { "type": "image_picker", "id": "logo_image", "label": "Logo (default)" },
    { "type": "image_picker", "id": "logo_image_scrolled", "label": "Logo (scrolled/hover)" },
    { "type": "range", "id": "logo_width", "label": "Logo width", "min": 60, "max": 240, "step": 5, "default": 140 },
    { "type": "range", "id": "logo_width_mobile", "label": "Logo width (mobile)", "min": 60, "max": 200, "step": 5, "default": 110 },
    { "type": "range", "id": "logo_height", "label": "Logo max height", "min": 20, "max": 80, "step": 2, "default": 44 },
    { "type": "range", "id": "logo_font_size", "label": "Logo text size", "min": 10, "max": 32, "step": 1, "default": 14 },
    { "type": "range", "id": "navbar_height", "label": "Navbar padding", "min": 5, "max": 30, "step": 1, "default": 15 }
  ],
  "blocks": [
    {
      "type": "banner_item",
      "name": "Banner item",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping on orders over $100" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },
    {
      "type": "menu_images",
      "name": "Menu Images",
      "settings": [
        { "type": "text", "id": "menu_title", "label": "Menu title" },
        { "type": "image_picker", "id": "image_1", "label": "Image 1" },
        { "type": "image_picker", "id": "image_2", "label": "Image 2" }
      ]
    }
  ]
}
{% endschema %}
