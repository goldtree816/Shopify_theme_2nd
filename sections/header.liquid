<style>
html {
  overflow-x: hidden;
}

body {
  font-family: var(--font-primary--family);
}

#site-header {
  left: 0;
  right: 0;
  width: 100%;
  max-width: 100%;
  overflow-x: hidden;
  position: fixed;
  top: var(--announcement-bar-current-height, 0px);
  --header-bg-color: #ffffff;
  --header-text-color: #231f20;
  --header-trtxt-color: #ffffff;
  --header-tx-color: transparent;
}

:root {
  --site-header-offset: 96px;
}

body:not(.template-index) {
  padding-top: var(--site-header-offset);
}

/* ================= NAVBAR ================= */
.navbar {
  width: 100%;
  background-color: var(--header-bg-color);
  color: var(--header-text-color);
  padding: {{ section.settings.navbar_height }}px 40px;
  position: relative;
  z-index: 1000;
  transition: background-color 0.25s ease, box-shadow 0.25s ease;
  box-sizing: border-box;
}

.navbar-inner {
  max-width: 1400px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  width: 100%;
  box-sizing: border-box;
}

/* Scroll background */
.navbar.scrolled {
  background-color: var(--header-bg-color);
  box-shadow: none;
}

/* ================= NAV GROUPS ================= */
.nav-left,
.nav-right {
  display: flex;
  align-items: center;
  gap: {{ section.settings.nav_item_spacing }}px;
  font-size: {{ section.settings.nav_font_size }}px;
  box-sizing: border-box;
}

/* Center logo */
.nav-center {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  --logo-width: {{ section.settings.logo_width | default: 140 }}px;
  --logo-width-mobile: {{ section.settings.logo_width_mobile | default: 110 }}px;
  --logo-height: {{ section.settings.logo_height | default: 44 }}px;
  box-sizing: border-box;
}

.nav-center a {
  color: white;
  font-size: {{ section.settings.logo_font_size }}px;
  text-decoration: none;
}

.nav-logo {
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.nav-logo img {
  display: block;
  width: auto;
  height: auto;
  max-width: var(--logo-width);
  max-height: var(--logo-height);
}

.nav-center .logo-scrolled {
  display: none;
}

.nav-center.has-alt-logo .logo-scrolled {
  display: none;
}

.navbar.scrolled .nav-center.has-alt-logo .logo-default,
.navbar:hover .nav-center.has-alt-logo .logo-default {
  display: none;
}

.navbar.scrolled .nav-center.has-alt-logo .logo-scrolled,
.navbar:hover .nav-center.has-alt-logo .logo-scrolled {
  display: block;
}

.nav-center .logo-text {
  font-size: {{ section.settings.logo_font_size }}px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.navbar.scrolled .nav-center .logo-text,
.navbar:hover .nav-center .logo-text {
  color: var(--color-foreground);
}

@media (max-width: 768px) {
  .nav-logo img {
    max-width: var(--logo-width-mobile);
  }
}

.navbar.scrolled .nav-center a,
.navbar:hover .nav-center a {
  color: var(--color-foreground);
}

/* Links */
.navbar a {
  color: inherit;
  text-decoration: none;
  transition: color 0.25s ease;
}

.navbar a:hover {
  text-decoration: underline;
}

/* Icons */
.nav-right svg {
  width: 20px;
  height: 20px;
}

.navbar svg {
  color: inherit;
}

.navbar svg path {
  fill: currentColor;
}

.nav-toggle {
  display: none;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: 0;
  color: inherit;
  padding: 6px;
  margin: 0;
  cursor: pointer;
}

.nav-toggle-bars {
  width: 22px;
  height: 14px;
  position: relative;
  display: inline-block;
}

.nav-toggle-bars span {
  position: absolute;
  left: 0;
  right: 0;
  height: 2px;
  background: currentColor;
  border-radius: 2px;
  transition: transform 0.2s ease;
}

.navbar .nav-toggle {
  color: var(--header-text-color);
}

/* Transparent header state (homepage top) */
#site-header.header--transparent .navbar {
  background-color: var(--header-tx-color);
  box-shadow: none;
  color: var(--header-trtxt-color);
}

#site-header.header--transparent .nav-toggle {
  color: var(--header-trtxt-color);
}

#site-header.header--transparent .nav-toggle-bars span {
  background: currentColor;
}

@media (min-width: 1025px) {
  #site-header.header--transparent:hover .navbar {
    background-color: var(--header-bg-color);
    box-shadow: none;
    color: var(--header-text-color);
  }

  #site-header.header--transparent:hover .nav-toggle {
    color: var(--header-text-color);
  }

}

/* Arrow icons use fill */
.navbar .Svg--arrow-down path,
.navbar .RevolutionSelectbox--Button svg path {
  fill: currentColor;
}

.navbar.scrolled .nav-toggle-bars span {
  background: currentColor;
}

.nav-toggle-bars span:nth-child(1) {
  top: 0;
}

.nav-toggle-bars span:nth-child(2) {
  top: 6px;
}

.nav-toggle-bars span:nth-child(3) {
  bottom: 0;
}

.header--hamburger {
  display: flex;
  flex-direction: column;
  height: 1.0625rem;
  width: 1rem;
  padding: 0.25rem 0.125rem;
  box-sizing: border-box;
  justify-content: space-between;
}

.header--hamburger .bar {
  width: 100%;
  height: 1px;
  border-radius: 2rem;
  transition: opacity 0.1s ease, 0.25s ease-in-out;
  display: block;
  cursor: pointer;
  background: currentColor;
}

.header--hamburger.is-active .bar:nth-child(2) {
  opacity: 0;
}

.header--hamburger.is-active .bar:nth-child(1) {
  transform: translateY(0.25rem) rotate(45deg);
}

.header--hamburger.is-active .bar:nth-child(3) {
  transform: translateY(-0.25rem) rotate(-45deg);
}

.nav-left-links {
  display: flex;
  align-items: center;
  gap: {{ section.settings.nav_item_spacing }}px;
}

.nav-left-links a,
.nav-right .nav-link--text,
.nav-right .RevolutionSelectbox--Title {
  font-size: 0.875rem;
  font-weight: 400;
  letter-spacing: 0;
  text-transform: uppercase;
}

.nav-left-links a,
.nav-right .nav-link--text {
  position: relative;
}

.nav-left-links a::before,
.nav-right .nav-link--text::before {
  content: "";
  position: absolute;
  width: 0;
  height: 1px;
  left: 0;
  bottom: -1px;
  background: currentColor;
  transition: width 0.45s cubic-bezier(.23,1,.32,1);
}

.nav-left-links a:hover::before,
.nav-right .nav-link--text:hover::before {
  width: 100%;
}

/* ================= DROPDOWN ================= */
.nav-item {
  position: relative;
}

.dropdown-menu {
  position: fixed;
  left: 0;
  width: 100%;
  padding: 30px 120px;
  background: var(--color-background);
  opacity: 0;
  visibility: hidden;
  transform: translateY(-20px);
  transition: opacity 0.35s ease, transform 0.35s ease;
  pointer-events: none;
  z-index: 999;
}

.nav-item:hover .dropdown-menu {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
  pointer-events: auto;
}

.dropdown-content {
  display: flex;
  gap: 80px;
}

.dropdown-columns {
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.dropdown-columns ul {
  list-style: none;
  padding: 0;
}

.dropdown-columns a {
  color: var(--color-link);
  font-size: 14px;
}

.dropdown-images {
  display: flex;
  gap: 20px;
  width: 750px;
}

.dropdown-images img {
  width: 50%;
  height: 600px;
  object-fit: cover;
}

/* ================= MOBILE MENU ================= */
.mobile-menu-panel {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--color-background);
  color: var(--color-foreground);
  position: relative;
}

.mobile-menu-top {
  display: grid;
  grid-template-columns: 32px 1fr 72px;
  align-items: center;
  padding: 18px 18px 8px;
}

.mobile-menu-close {
  width: 32px;
  height: 32px;
  border: 0;
  background: transparent;
  font-size: 20px;
  line-height: 1;
  cursor: pointer;
}

.mobile-menu-logo {
  display: flex;
  justify-content: center;
  --logo-width: {{ section.settings.logo_width_mobile | default: 110 }}px;
  --logo-height: {{ section.settings.logo_height | default: 44 }}px;
}

.mobile-menu-icons {
  display: flex;
  justify-content: flex-end;
  gap: 14px;
}

.mobile-menu-icons a {
  color: var(--color-link);
}

.mobile-menu-views {
  position: relative;
  flex: 1;
  overflow: hidden;
}

.mobile-menu-view {
  position: absolute;
  inset: 0;
  padding: 12px 22px 20px;
  overflow-y: auto;
  background: var(--color-background);
  transition: transform 0.3s ease, opacity 0.3s ease;
  pointer-events: none;
}

.mobile-menu-view--root {
  transform: translateX(0);
  opacity: 1;
}

.mobile-menu-view--submenu {
  transform: translateX(100%);
  opacity: 0;
}

.mobile-menu-view.is-active {
  transform: translateX(0);
  opacity: 1;
  z-index: 1;
  pointer-events: auto;
}

.mobile-menu-panel[data-active-submenu]:not([data-active-submenu="root"]) .mobile-menu-view--root {
  transform: translateX(-100%);
  opacity: 0;
}

.mobile-menu-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.mobile-menu-item {
  margin: 0;
}

.mobile-menu-link {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 0;
  border: 0;
  background: transparent;
  cursor: pointer;
  text-decoration: none;
  color: var(--color-link);
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.mobile-menu-link:focus {
  outline: none;
}

.mobile-menu-label {
  display: inline-block;
}

.mobile-menu-label.is-new {
  background: var(--color-accent-soft);
  color: var(--color-link-hover);
  padding: 2px 6px;
  border-radius: 2px;
}

.mobile-menu-chevron {
  font-size: 16px;
  color: var(--color-muted);
  margin-left: auto;
}

.mobile-submenu-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6px 0 14px;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  color: var(--color-muted);
}

.mobile-submenu-back {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  border: 0;
  background: transparent;
  padding: 0;
  font-size: 11px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--color-muted);
  cursor: pointer;
}

.mobile-submenu-title {
  color: var(--color-foreground);
  font-weight: 600;
}

.mobile-submenu-list {
  list-style: none;
  padding: 6px 0 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.mobile-submenu-item a {
  text-decoration: none;
  color: var(--color-foreground);
  font-size: 14px;
  letter-spacing: 0.02em;
  font-weight: 400;
}

.mobile-menu-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 20px 16px;
  border-top: 1px solid var(--color-border);
  font-size: 12px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--color-muted);
}

.mobile-menu-footer a {
  color: var(--color-muted);
  text-decoration: none;
}

@media (max-width: 768px) {
  .navbar {
    padding: 12px 16px;
  }

  .nav-left-links {
    display: none;
  }

  .nav-toggle {
    display: inline-flex;
  }

  .nav-right .nav-link--text,
  .nav-right .nav-link--account {
    display: none;
  }

  .drawer.mobile-menu-drawer {
    right: -100%;
    width: 100%;
  }

  .drawer.mobile-menu-drawer.open {
    right: 0;
  }

  .drawer.mobile-menu-drawer .drawer-header {
    display: none;
  }

  .drawer.mobile-menu-drawer .drawer-content {
    padding: 0;
  }
}

@media (min-width: 1025px) {
  .nav-left,
  .nav-right {
    gap: 2rem;
  }

  .nav-left-links {
    gap: 2rem;
  }
}
</style>

<header id="site-header" class="fixed left-0 w-full z-50" style="top: var(--announcement-bar-current-height, 0px);">
  {% assign is_cart_template = false %}
  {% if template.name == 'cart' %}
    {% assign is_cart_template = true %}
  {% endif %}

  {% capture header_logo %}
    <a href="{{ routes.root_url }}" class="nav-logo" aria-label="{{ shop.name }}">
      {% if section.settings.logo_image != blank %}
        <img class="logo-default" src="{{ section.settings.logo_image | image_url: width: 400 }}" alt="{{ section.settings.logo_image.alt | default: shop.name }}">
        {% if section.settings.logo_image_scrolled != blank %}
          <img class="logo-scrolled" src="{{ section.settings.logo_image_scrolled | image_url: width: 400 }}" alt="{{ section.settings.logo_image_scrolled.alt | default: shop.name }}">
        {% endif %}
      {% elsif settings.logo != blank %}
        <img class="logo-default" src="{{ settings.logo | image_url: width: 400 }}" alt="{{ shop.name }}">
      {% elsif shop.brand.logo != blank %}
        <img class="logo-default" src="{{ shop.brand.logo | image_url: width: 400 }}" alt="{{ shop.name }}">
      {% else %}
        <span class="logo-text">{{ shop.name }}</span>
      {% endif %}
    </a>
  {% endcapture %}

  <!-- NAVBAR -->
  <div class="navbar" id="navbar">
    <div class="navbar-inner">

      <!-- LEFT -->
      <nav class="nav-left">
        <button
          class="nav-toggle header--hamburger"
          type="button"
          aria-label="Open menu"
          data-action="toggle-drawer"
          data-toggle-id="mobile-menu"
        >
          <span class="bar"></span>
          <span class="bar"></span>
          <span class="bar"></span>
        </button>

        <div class="nav-left-links">
          {% for link in linklists[section.settings.left-navbar].links %}
            <div class="nav-item">
              <a href="{{ link.url }}">{{ link.title }}</a>

              {% if link.links != blank %}
                <div class="dropdown-menu">
                  <div class="dropdown-content">
                    <div class="dropdown-columns">
                      {% for child in link.links %}
                        <ul>
                          <li><strong>{{ child.title }}</strong></li>
                          {% for sub in child.links %}
                            <li><a href="{{ sub.url }}">{{ sub.title }}</a></li>
                          {% endfor %}
                        </ul>
                      {% endfor %}
                    </div>

                    <div class="dropdown-images">
                      {% for block in section.blocks %}
                        {% if block.settings.menu_title == link.title %}
                          {% if block.settings.image_1 %}
                            <img
                              src="{{ block.settings.image_1 | image_url }}"
                              alt="{{ block.settings.image_1.alt | default: block.settings.menu_title | default: link.title | default: shop.name | escape }}"
                              loading="lazy"
                            >
                          {% endif %}
                          {% if block.settings.image_2 %}
                            <img
                              src="{{ block.settings.image_2 | image_url }}"
                              alt="{{ block.settings.image_2.alt | default: block.settings.menu_title | default: link.title | default: shop.name | escape }}"
                              loading="lazy"
                            >
                          {% endif %}
                        {% endif %}
                      {% endfor %}
                    </div>
                  </div>
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </nav>

      <!-- CENTER -->
      <div class="nav-center {% if section.settings.logo_image_scrolled != blank %}has-alt-logo{% endif %}">
        {{ header_logo }}
      </div>

      <!-- RIGHT -->
      <nav class="nav-right">
        {% render 'localization-selectors',
          form_id: 'MarketLocalization--header-desktop',
          language_form_id: 'LanguageLocalization--header-desktop',
          title_class: 'u-p2',
          item_class: 'u-p2',
          placeholder_class: 'u-s2',
          wrapper_class: 'localization--desktop'
        %}
        {% for link in linklists[section.settings.right-navbar].links %}
          {% case link.title %}
            {% when "CART" %}
              {% if is_cart_template %}
                <a href="{{ routes.cart_url }}" class="nav-link nav-link--icon nav-link--cart" aria-label="Cart">{% render 'icon-shopping-bag' %}</a>
              {% else %}
                <a
                  href="{{ routes.cart_url }}"
                  class="nav-link nav-link--icon nav-link--cart"
                  aria-label="Cart"
                  data-action="toggle-drawer"
                  data-toggle-id="cart-drawer"
                >
                  {% render 'icon-shopping-bag' %}
                </a>
              {% endif %}
            {% when "SEARCH" %}
              <a href="{{ routes.search_url }}" class="nav-link nav-link--icon nav-link--search search-icon">{% render 'icon-search' %}</a>
            {% when "PROFILE" %}
              <a href="{{ routes.account_url }}" class="nav-link nav-link--icon nav-link--account">{% render 'icon-profile' %}</a>
            {% else %}
              <a href="{{ link.url }}" class="nav-link nav-link--text">{{ link.title }}</a>
          {% endcase %}
        {% endfor %}
      </nav>

    </div>
  </div>

  <main-menu-dropdown
    class="drawer colorGroup--primary not_desktop"
    aria-expanded="false"
    aria-hidden="true"
    id="mobile-menu"
  >
    <div class="drawer__content Drawer--Content">
      <div
        id="mobile-menu__grid--main"
        class="mobile-menu__grid mobile-menu__grid--level-one"
        aria-expanded="false"
        aria-hidden="true"
        data-scrollable
      >
        {% for link in linklists[section.settings.left-navbar].links %}
          {% assign link_title_up = link.title | upcase %}
          {% assign link_handle = link.title | handleize %}
          {% assign has_children = false %}
          {% if link.links != blank %}
            {% assign has_children = true %}
          {% endif %}
          <a
            href="{{ link.url }}"
            class="mobile-menu__link mobile-menu__link--level-one rte u-p2 pb-m pt-m{% if link_title_up == 'NEW IN' %} mobile-menu__link--highlight{% endif %}"
            {% if has_children %}
              aria-controls="mobile-menu__grid--{{ link_handle }}"
              data-action="open-submenu"
            {% endif %}
          >
            <span>{{ link.title }}</span>
            {% if has_children %}
              <svg class="Svg Svg--arrow-right" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M6.66656 16.078C6.66571 15.9304 6.72368 15.7884 6.82767 15.6836L12.5443 9.96693L6.82767 4.25026C6.63891 4.02984 6.6516 3.70126 6.8568 3.49606C7.06201 3.29085 7.39058 3.27816 7.611 3.46692L14.1166 9.96693L7.611 16.4725C7.45156 16.6288 7.21403 16.6744 7.00801 16.5884C6.80198 16.5023 6.66748 16.3013 6.66656 16.078Z" fill="#231F20"/>
              </svg>
            {% endif %}
          </a>
        {% endfor %}
      </div>

      {% for link in linklists[section.settings.left-navbar].links %}
        {% assign link_handle = link.title | handleize %}
        {% if link.links != blank %}
          <div
            id="mobile-menu__grid--{{ link_handle }}"
            class="mobile-menu__grid mobile-menu__grid--level-two"
            aria-expanded="false"
            aria-hidden="true"
            data-scrollable
          >
            <a
              href="{{ link.url }}"
              class="mobile-menu__back-button rte u-p3 pt-m pb-m"
              aria-controls="mobile-menu__grid--main"
              data-action="close-submenu"
            >
              <svg class="Svg Svg--arrow-left" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M13.2687 2.43437C13.2397 2.40508 13.2051 2.38184 13.167 2.36597C13.129 2.35011 13.0881 2.34194 13.0469 2.34194C13.0056 2.34194 12.9648 2.35011 12.9267 2.36597C12.8886 2.38184 12.854 2.40508 12.825 2.43437L5.48123 9.77813C5.45194 9.80718 5.42869 9.84174 5.41283 9.87982C5.39696 9.9179 5.38879 9.95875 5.38879 10C5.38879 10.0413 5.39696 10.0821 5.41283 10.1202C5.42869 10.1583 5.45194 10.1928 5.48123 10.2219L12.8125 17.5656C12.8415 17.5949 12.8761 17.6182 12.9142 17.634C12.9523 17.6499 12.9931 17.6581 13.0344 17.6581C13.0756 17.6581 13.1165 17.6499 13.1545 17.634C13.1926 17.6182 13.2272 17.5949 13.2562 17.5656C13.2855 17.5366 13.3088 17.502 13.3246 17.4639C13.3405 17.4258 13.3487 17.385 13.3487 17.3438C13.3487 17.3025 13.3405 17.2617 13.3246 17.2236C13.3088 17.1855 13.2855 17.1509 13.2562 17.1219L6.14373 10L13.2687 2.87813C13.298 2.84907 13.3213 2.81451 13.3371 2.77643C13.353 2.73835 13.3612 2.6975 13.3612 2.65625C13.3612 2.615 13.353 2.57415 13.3371 2.53607C13.3213 2.49799 13.298 2.46343 13.2687 2.43437Z" fill="#231F20"/>
              </svg>
              <span>BACK</span>
              {{ link.title }}
            </a>

            {% for child in link.links %}
              {% assign child_handle = child.title | handleize %}
              {% if child.links != blank %}
                <a
                  href="{{ child.url }}"
                  class="mobile-menu__link mobile-menu__link--level-two rte u-p2 pb-m pt-m{% if forloop.first %} mt-l{% endif %}"
                  aria-controls="mobile-menu__grid--{{ link_handle }}-{{ child_handle }}"
                  data-action="open-submenu"
                >
                  <span>{{ child.title }}</span>
                  <svg class="Svg Svg--arrow-right" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M6.66656 16.078C6.66571 15.9304 6.72368 15.7884 6.82767 15.6836L12.5443 9.96693L6.82767 4.25026C6.63891 4.02984 6.6516 3.70126 6.8568 3.49606C7.06201 3.29085 7.39058 3.27816 7.611 3.46692L14.1166 9.96693L7.611 16.4725C7.45156 16.6288 7.21403 16.6744 7.00801 16.5884C6.80198 16.5023 6.66748 16.3013 6.66656 16.078Z" fill="#231F20"/>
                  </svg>
                </a>
              {% else %}
                <a
                  href="{{ child.url }}"
                  class="mobile-menu__link mobile-menu__link--level-two rte u-p2 pb-m pt-m{% if forloop.first %} mt-l{% endif %}"
                >
                  <span>{{ child.title }}</span>
                </a>
              {% endif %}
            {% endfor %}
          </div>

          {% for child in link.links %}
            {% if child.links != blank %}
              {% assign child_handle = child.title | handleize %}
              <div
                id="mobile-menu__grid--{{ link_handle }}-{{ child_handle }}"
                class="mobile-menu__grid mobile-menu__grid--level-three"
                aria-expanded="false"
                aria-hidden="true"
                data-scrollable
              >
                <a
                  href="{{ child.url }}"
                  class="mobile-menu__back-button rte u-p3 pt-m pb-m"
                  aria-controls="mobile-menu__grid--{{ link_handle }}"
                  data-action="close-submenu"
                >
                  <svg class="Svg Svg--arrow-left" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M13.2687 2.43437C13.2397 2.40508 13.2051 2.38184 13.167 2.36597C13.129 2.35011 13.0881 2.34194 13.0469 2.34194C13.0056 2.34194 12.9648 2.35011 12.9267 2.36597C12.8886 2.38184 12.854 2.40508 12.825 2.43437L5.48123 9.77813C5.45194 9.80718 5.42869 9.84174 5.41283 9.87982C5.39696 9.9179 5.38879 9.95875 5.38879 10C5.38879 10.0413 5.39696 10.0821 5.41283 10.1202C5.42869 10.1583 5.45194 10.1928 5.48123 10.2219L12.8125 17.5656C12.8415 17.5949 12.8761 17.6182 12.9142 17.634C12.9523 17.6499 12.9931 17.6581 13.0344 17.6581C13.0756 17.6581 13.1165 17.6499 13.1545 17.634C13.1926 17.6182 13.2272 17.5949 13.2562 17.5656C13.2855 17.5366 13.3088 17.502 13.3246 17.4639C13.3405 17.4258 13.3487 17.385 13.3487 17.3438C13.3487 17.3025 13.3405 17.2617 13.3246 17.2236C13.3088 17.1855 13.2855 17.1509 13.2562 17.1219L6.14373 10L13.2687 2.87813C13.298 2.84907 13.3213 2.81451 13.3371 2.77643C13.353 2.73835 13.3612 2.6975 13.3612 2.65625C13.3612 2.615 13.353 2.57415 13.3371 2.53607C13.3213 2.49799 13.298 2.46343 13.2687 2.43437Z" fill="#231F20"/>
                  </svg>
                  <span>BACK</span>
                  {{ child.title }}
                </a>
                {% for grandchild in child.links %}
                  <a
                    href="{{ grandchild.url }}"
                    class="mobile-menu__link mobile-menu__link--level-three rte u-p2 pb-m pt-m{% if forloop.first %} mt-l{% endif %}"
                  >
                    <span>{{ grandchild.title }}</span>
                  </a>
                {% endfor %}
              </div>
            {% endif %}
          {% endfor %}
        {% endif %}
      {% endfor %}
    </div>

    <div class="localizationOverlay" aria-hidden="true"></div>
    <div class="drawer__footer Drawer--Footer">
      <div class="drawer__footer-inner">
        <div class="mobile-menu__action-bar">
          <div class="mobile-menu__selectors not_desktop">
            {% render 'localization-selectors',
              form_id: 'MarketLocalization--header-mobile',
              language_form_id: 'LanguageLocalization--header-mobile',
              title_class: 'u-p3',
              item_class: 'u-p2',
              placeholder_class: 'u-t2',
              content_class: 'PopoverContent',
              wrapper_class: 'localization--mobile'
            %}
          </div>
          <div class="mobile-menu__action-items">
            <a href="{{ routes.account_url }}" class="u-p3">Account</a>
          </div>
        </div>
      </div>
    </div>
  </main-menu-dropdown>
</header>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const body = document.body;
  const header = document.getElementById("site-header");
  const navbar = document.getElementById("navbar");
  if (!header || !navbar) return;

  const isHomeTemplate = body.classList.contains("template-index") || window.location.pathname === "/";

  function updateHeaderOffset() {
    const headerTop = parseFloat(window.getComputedStyle(header).top || "0") || 0;
    const offset = Math.max(0, Math.round(header.offsetHeight + headerTop));
    document.documentElement.style.setProperty("--site-header-offset", `${offset}px`);
    document.documentElement.style.setProperty("--header-dynamic-height", `${Math.round(header.offsetHeight)}px`);
    const announcement = document.querySelector(".announcement-bar");
    const announcementHeight = announcement ? Math.round(announcement.offsetHeight) : 0;
    document.documentElement.style.setProperty("--announcement-dynamic-height", `${announcementHeight}px`);
  }

  function onScroll() {
    const forceScrolled = body.classList.contains("search-force-scrolled");
    const shouldBeScrolled = forceScrolled || !isHomeTemplate || window.scrollY > 10;
    const shouldBeTransparent = isHomeTemplate && !forceScrolled && window.scrollY <= 10;
    const announcementBar = document.querySelector(".announcement-bar");

    if (shouldBeScrolled) {
      header.classList.add("is-scrolled");
      navbar.classList.add("scrolled");
    } else {
      header.classList.remove("is-scrolled");
      navbar.classList.remove("scrolled");
    }

    header.classList.toggle("header--transparent", shouldBeTransparent);

    if (announcementBar) {
      announcementBar.classList.toggle("announcementBar--transparent", shouldBeTransparent);
      announcementBar.classList.toggle("announcement__bar-bg", !shouldBeTransparent);
    }

    updateHeaderOffset();
  }

  window.addEventListener("scroll", onScroll, { passive: true });
  window.addEventListener("resize", onScroll, { passive: true });
  window.addEventListener("load", onScroll);
  onScroll();

  const announcementBar = document.querySelector(".announcement-bar");
  if (announcementBar) {
    header.addEventListener("mouseenter", () => {
      if (header.classList.contains("header--transparent")) {
        announcementBar.classList.add("announcement__bar-bg-open");
      }
    });

    header.addEventListener("mouseleave", () => {
      announcementBar.classList.remove("announcement__bar-bg-open");
    });
  }

});
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "left-navbar", "label": "Left menu" },
    { "type": "link_list", "id": "right-navbar", "label": "Right menu" },
    { "type": "range", "id": "nav_item_spacing", "label": "Item spacing", "min": 0, "max": 50, "step": 1, "default": 20 },
    { "type": "range", "id": "nav_font_size", "label": "Font size", "min": 10, "max": 24, "step": 1, "default": 14 },
    { "type": "image_picker", "id": "logo_image", "label": "Logo (default)" },
    { "type": "image_picker", "id": "logo_image_scrolled", "label": "Logo (scrolled/hover)" },
    { "type": "range", "id": "logo_width", "label": "Logo width", "min": 60, "max": 240, "step": 5, "default": 140 },
    { "type": "range", "id": "logo_width_mobile", "label": "Logo width (mobile)", "min": 60, "max": 200, "step": 5, "default": 110 },
    { "type": "range", "id": "logo_height", "label": "Logo max height", "min": 20, "max": 80, "step": 2, "default": 44 },
    { "type": "range", "id": "logo_font_size", "label": "Logo text size", "min": 10, "max": 32, "step": 1, "default": 14 },
    { "type": "range", "id": "navbar_height", "label": "Navbar padding", "min": 5, "max": 30, "step": 1, "default": 15 }
  ],
  "blocks": [
    {
      "type": "menu_images",
      "name": "Menu Images",
      "settings": [
        { "type": "text", "id": "menu_title", "label": "Menu title" },
        { "type": "image_picker", "id": "image_1", "label": "Image 1" },
        { "type": "image_picker", "id": "image_2", "label": "Image 2" }
      ]
    }
  ]
}
{% endschema %}
