<style>
html {
  overflow-x: hidden;
}

body {
  font-family: var(--font-primary--family);
}

/* ================= TOP BANNER ================= */
.top-banner {
  position: relative;
  width: 100vw;
  text-align: center;
  font-size: var(--banner-text-size);
  font-weight: 600;
  color: var(--banner-text-color);
  min-height: var(--banner-height);
  padding: 4px 16px;
  border-bottom: 1px solid rgba(255,255,255,0.2);
  background-color: {{ section.settings.banner_bg_color }};
  transition: height 0.25s ease, padding 0.25s ease, opacity 0.25s ease;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  --banner-height: {{ section.settings.banner_height | default: 36 }}px;
  --banner-height-mobile: {{ section.settings.banner_height_mobile | default: 32 }}px;
  --banner-text-size: {{ section.settings.banner_text_size | default: 13 }}px;
  --banner-text-size-mobile: {{ section.settings.banner_text_size_mobile | default: 12 }}px;
  --banner-text-color: {{ section.settings.banner_text_color | default: '#ffffff' }};
  --banner-transition: {{ section.settings.banner_transition_ms | default: 600 }}ms;
}

header:hover .top-banner {
  background-color: {{ section.settings.banner_hover_bg_color | default: '#a3bfdb' }};
  color: {{ section.settings.banner_hover_text_color | default: '#1d3d7a' }};
  border-bottom: 1px solid var(--color-border);
}

header:hover .top-banner a {
  color: {{ section.settings.banner_hover_link_color | default: '#1d3d7a' }};
}

.top-banner__viewport {
  width: 100%;
  overflow: hidden;
}

.top-banner__track {
  display: flex;
  flex-direction: column;
  transform: translateY(0);
  transition: transform var(--banner-transition) cubic-bezier(0.2, 0.7, 0, 1);
  will-change: transform;
}

.top-banner__item {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  min-height: var(--banner-height);
  line-height: 1.3;
  padding: 2px 0;
}

.top-banner__text {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.top-banner__link {
  color: {{ section.settings.banner_link_color }};
  text-decoration: underline;
  text-underline-offset: 2px;
  white-space: nowrap;
}

/* ================= NAVBAR ================= */
.navbar {
  width: 100%;
  background-color: transparent;
  padding: {{ section.settings.navbar_height }}px 40px;
  position: relative;
  z-index: 1000;
  transition: background-color 0.25s ease, box-shadow 0.25s ease;
}

.navbar-inner {
  max-width: 1400px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
}

/* Hover / scroll background */
header:hover .navbar:hover,
.navbar.scrolled {
  background-color: var(--color-background);
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

.navbar.scrolled a {
  color: var(--color-link);
}

.navbar:hover a {
  color: var(--color-link);
}

/* ================= NAV GROUPS ================= */
.nav-left,
.nav-right {
  display: flex;
  align-items: center;
  gap: {{ section.settings.nav_item_spacing }}px;
  font-size: {{ section.settings.nav_font_size }}px;
}

/* Center logo */
.nav-center {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  --logo-width: {{ section.settings.logo_width | default: 140 }}px;
  --logo-width-mobile: {{ section.settings.logo_width_mobile | default: 110 }}px;
  --logo-height: {{ section.settings.logo_height | default: 44 }}px;
}

.nav-center a {
  color: white;
  font-size: {{ section.settings.logo_font_size }}px;
  text-decoration: none;
}

.nav-logo {
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.nav-logo img {
  display: block;
  width: auto;
  height: auto;
  max-width: var(--logo-width);
  max-height: var(--logo-height);
}

.nav-center .logo-scrolled {
  display: none;
}

.nav-center.has-alt-logo .logo-scrolled {
  display: none;
}

.navbar.scrolled .nav-center.has-alt-logo .logo-default,
.navbar:hover .nav-center.has-alt-logo .logo-default {
  display: none;
}

.navbar.scrolled .nav-center.has-alt-logo .logo-scrolled,
.navbar:hover .nav-center.has-alt-logo .logo-scrolled {
  display: block;
}

.nav-center .logo-text {
  font-size: {{ section.settings.logo_font_size }}px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.navbar.scrolled .nav-center .logo-text,
.navbar:hover .nav-center .logo-text {
  color: var(--color-foreground);
}

@media (max-width: 768px) {
  .nav-logo img {
    max-width: var(--logo-width-mobile);
  }
}

@media (max-width: 640px) {
  .top-banner {
    min-height: var(--banner-height-mobile);
    font-size: var(--banner-text-size-mobile);
  }
}

.navbar.scrolled .nav-center a,
.navbar:hover .nav-center a {
  color: var(--color-foreground);
}

/* Links */
.navbar a {
  color: white;
  text-decoration: none;
  transition: color 0.25s ease;
}

.navbar a:hover {
  text-decoration: underline;
}

/* Icons */
.nav-right svg {
  width: 26px;
  height: 26px;
}

.nav-toggle {
  display: none;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: 0;
  color: inherit;
  padding: 6px;
  margin: 0;
  cursor: pointer;
}

.nav-toggle-bars {
  width: 22px;
  height: 14px;
  position: relative;
  display: inline-block;
}

.nav-toggle-bars span {
  position: absolute;
  left: 0;
  right: 0;
  height: 2px;
  background: currentColor;
  border-radius: 2px;
  transition: transform 0.2s ease;
}

.nav-toggle-bars span:nth-child(1) {
  top: 0;
}

.nav-toggle-bars span:nth-child(2) {
  top: 6px;
}

.nav-toggle-bars span:nth-child(3) {
  bottom: 0;
}

.nav-left-links {
  display: flex;
  align-items: center;
  gap: {{ section.settings.nav_item_spacing }}px;
}

/* ================= DROPDOWN ================= */
.nav-item {
  position: relative;
}

.dropdown-menu {
  position: fixed;
  left: 0;
  width: 100vw;
  padding: 30px 120px;
  background: var(--color-background);
  opacity: 0;
  visibility: hidden;
  transform: translateY(-20px);
  transition: opacity 0.35s ease, transform 0.35s ease;
  pointer-events: none;
  z-index: 999;
}

.nav-item:hover .dropdown-menu {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
  pointer-events: auto;
}

.dropdown-content {
  display: flex;
  gap: 80px;
}

.dropdown-columns {
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.dropdown-columns ul {
  list-style: none;
  padding: 0;
}

.dropdown-columns a {
  color: var(--color-link);
  font-size: 14px;
}

.dropdown-images {
  display: flex;
  gap: 20px;
  width: 750px;
}

.dropdown-images img {
  width: 50%;
  height: 600px;
  object-fit: cover;
}

/* ================= SCROLL BEHAVIOR ================= */
/* ONLY banner collapses – navbar height stays same */
#site-header.is-scrolled .top-banner {
  height: 0;
  min-height: 0;
  padding: 0;
  opacity: 0;
  border: none;
}

/* ================= MOBILE MENU ================= */
.mobile-menu-panel {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--color-background);
  color: var(--color-foreground);
  position: relative;
}

.mobile-menu-top {
  display: grid;
  grid-template-columns: 32px 1fr 72px;
  align-items: center;
  padding: 18px 18px 8px;
}

.mobile-menu-close {
  width: 32px;
  height: 32px;
  border: 0;
  background: transparent;
  font-size: 20px;
  line-height: 1;
  cursor: pointer;
}

.mobile-menu-logo {
  display: flex;
  justify-content: center;
  --logo-width: {{ section.settings.logo_width_mobile | default: 110 }}px;
  --logo-height: {{ section.settings.logo_height | default: 44 }}px;
}

.mobile-menu-icons {
  display: flex;
  justify-content: flex-end;
  gap: 14px;
}

.mobile-menu-icons a {
  color: var(--color-link);
}

.mobile-menu-banner {
  width: 100%;
}

.mobile-menu-views {
  position: relative;
  flex: 1;
  overflow: hidden;
}

.mobile-menu-view {
  position: absolute;
  inset: 0;
  padding: 12px 22px 20px;
  overflow-y: auto;
  background: var(--color-background);
  transition: transform 0.3s ease, opacity 0.3s ease;
  pointer-events: none;
}

.mobile-menu-view--root {
  transform: translateX(0);
  opacity: 1;
}

.mobile-menu-view--submenu {
  transform: translateX(100%);
  opacity: 0;
}

.mobile-menu-view.is-active {
  transform: translateX(0);
  opacity: 1;
  z-index: 1;
  pointer-events: auto;
}

.mobile-menu-panel[data-active-submenu]:not([data-active-submenu="root"]) .mobile-menu-view--root {
  transform: translateX(-100%);
  opacity: 0;
}

.mobile-menu-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.mobile-menu-item {
  margin: 0;
}

.mobile-menu-link {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 0;
  border: 0;
  background: transparent;
  cursor: pointer;
  text-decoration: none;
  color: var(--color-link);
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.mobile-menu-link:focus {
  outline: none;
}

.mobile-menu-label {
  display: inline-block;
}

.mobile-menu-label.is-new {
  background: var(--color-accent-soft);
  color: var(--color-link-hover);
  padding: 2px 6px;
  border-radius: 2px;
}

.mobile-menu-chevron {
  font-size: 16px;
  color: var(--color-muted);
  margin-left: auto;
}

.mobile-submenu-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6px 0 14px;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  color: var(--color-muted);
}

.mobile-submenu-back {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  border: 0;
  background: transparent;
  padding: 0;
  font-size: 11px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--color-muted);
  cursor: pointer;
}

.mobile-submenu-title {
  color: var(--color-foreground);
  font-weight: 600;
}

.mobile-submenu-list {
  list-style: none;
  padding: 6px 0 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.mobile-submenu-item a {
  text-decoration: none;
  color: var(--color-foreground);
  font-size: 14px;
  letter-spacing: 0.02em;
  font-weight: 400;
}

.mobile-menu-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 20px 16px;
  border-top: 1px solid var(--color-border);
  font-size: 12px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--color-muted);
}

.mobile-menu-footer a {
  color: var(--color-muted);
  text-decoration: none;
}

@media (max-width: 768px) {
  .navbar {
    padding: 12px 16px;
  }

  .nav-left-links {
    display: none;
  }

  .nav-toggle {
    display: inline-flex;
  }

  .nav-right .nav-link--text,
  .nav-right .nav-link--account {
    display: none;
  }

  .drawer.mobile-menu-drawer {
    right: -100%;
    width: 100%;
  }

  .drawer.mobile-menu-drawer.open {
    right: 0;
  }

  .drawer.mobile-menu-drawer .drawer-header {
    display: none;
  }

  .drawer.mobile-menu-drawer .drawer-content {
    padding: 0;
  }
}
</style>

<header id="site-header" class="fixed top-0 left-0 w-full z-50">

  {% assign banner_blocks = section.blocks | where: 'type', 'banner_item' %}
  {% if section.settings.banner_enable %}
    <!-- TOP BANNER -->
    <div
      class="top-banner"
      data-autoplay="{{ section.settings.banner_autoplay }}"
      data-interval="{{ section.settings.banner_interval }}"
      data-transition="{{ section.settings.banner_transition_ms }}"
      data-pause-on-hover="{{ section.settings.banner_pause_on_hover }}"
    >
      <div class="top-banner__viewport">
        <div class="top-banner__track">
          {% if banner_blocks.size > 0 %}
            {% for block in banner_blocks %}
              <div class="top-banner__item" {{ block.shopify_attributes }}>
                {% if block.settings.text != blank %}
                  <span class="top-banner__text">{{ block.settings.text }}</span>
                {% endif %}
                {% if block.settings.link_label != blank %}
                  {% if block.settings.link != blank %}
                    <a class="top-banner__link" href="{{ block.settings.link }}">
                      {{ block.settings.link_label }}
                    </a>
                  {% else %}
                    <span class="top-banner__link">{{ block.settings.link_label }}</span>
                  {% endif %}
                {% endif %}
              </div>
            {% endfor %}
          {% else %}
            <div class="top-banner__item">
              {% if section.settings.banner_text != blank %}
                <span class="top-banner__text">{{ section.settings.banner_text }}</span>
              {% endif %}
              {% if section.settings.banner_link_label != blank %}
                {% if section.settings.banner_link != blank %}
                  <a class="top-banner__link" href="{{ section.settings.banner_link }}">
                    {{ section.settings.banner_link_label }}
                  </a>
                {% else %}
                  <span class="top-banner__link">{{ section.settings.banner_link_label }}</span>
                {% endif %}
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  {% endif %}

  {% capture header_logo %}
    <a href="{{ routes.root_url }}" class="nav-logo" aria-label="{{ shop.name }}">
      {% if section.settings.logo_image != blank %}
        <img class="logo-default" src="{{ section.settings.logo_image | image_url: width: 400 }}" alt="{{ section.settings.logo_image.alt | default: shop.name }}">
        {% if section.settings.logo_image_scrolled != blank %}
          <img class="logo-scrolled" src="{{ section.settings.logo_image_scrolled | image_url: width: 400 }}" alt="{{ section.settings.logo_image_scrolled.alt | default: shop.name }}">
        {% endif %}
      {% elsif settings.logo != blank %}
        <img class="logo-default" src="{{ settings.logo | image_url: width: 400 }}" alt="{{ shop.name }}">
      {% elsif shop.brand.logo != blank %}
        <img class="logo-default" src="{{ shop.brand.logo | image_url: width: 400 }}" alt="{{ shop.name }}">
      {% else %}
        <span class="logo-text">{{ shop.name }}</span>
      {% endif %}
    </a>
  {% endcapture %}

  <!-- NAVBAR -->
  <div class="navbar" id="navbar">
    <div class="navbar-inner">

      <!-- LEFT -->
      <nav class="nav-left">
        <button
          class="nav-toggle"
          type="button"
          aria-label="Open menu"
          data-drawer-open="#mobile-menu"
          data-drawer-class="mobile-menu-drawer"
        >
          <span class="nav-toggle-bars" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
        </button>

        <div class="nav-left-links">
          {% for link in linklists[section.settings.left-navbar].links %}
            <div class="nav-item">
              <a href="{{ link.url }}">{{ link.title }}</a>

              {% if link.links != blank %}
                <div class="dropdown-menu">
                  <div class="dropdown-content">
                    <div class="dropdown-columns">
                      {% for child in link.links %}
                        <ul>
                          <li><strong>{{ child.title }}</strong></li>
                          {% for sub in child.links %}
                            <li><a href="{{ sub.url }}">{{ sub.title }}</a></li>
                          {% endfor %}
                        </ul>
                      {% endfor %}
                    </div>

                    <div class="dropdown-images">
                      {% for block in section.blocks %}
                        {% if block.settings.menu_title == link.title %}
                          {% if block.settings.image_1 %}
                            <img src="{{ block.settings.image_1 | image_url }}">
                          {% endif %}
                          {% if block.settings.image_2 %}
                            <img src="{{ block.settings.image_2 | image_url }}">
                          {% endif %}
                        {% endif %}
                      {% endfor %}
                    </div>
                  </div>
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </nav>

      <!-- CENTER -->
      <div class="nav-center {% if section.settings.logo_image_scrolled != blank %}has-alt-logo{% endif %}">
        {{ header_logo }}
      </div>

      <!-- RIGHT -->
      <nav class="nav-right">
        {% for link in linklists[section.settings.right-navbar].links %}
          {% case link.title %}
            {% when "CART" %}
              <a href="#" class="nav-link nav-link--icon nav-link--cart open-cart-drawer">{% render 'icon-shopping-bag' %}</a>
            {% when "SEARCH" %}
              <a href="/search" class="nav-link nav-link--icon nav-link--search search-icon">{% render 'icon-search' %}</a>
            {% when "PROFILE" %}
              <a href="/account" class="nav-link nav-link--icon nav-link--account">{% render 'icon-profile' %}</a>
            {% else %}
              <a href="{{ link.url }}" class="nav-link nav-link--text">{{ link.title }}</a>
          {% endcase %}
        {% endfor %}
      </nav>

    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu" hidden>
    <div class="mobile-menu-panel" data-active-submenu="root">
      {% if section.settings.banner_enable %}
        {% assign menu_banner_block = banner_blocks[0] %}
        <div class="top-banner mobile-menu-banner">
          <div class="top-banner__item">
            {% if menu_banner_block != blank %}
              {% if menu_banner_block.settings.text != blank %}
                <span class="top-banner__text">{{ menu_banner_block.settings.text }}</span>
              {% endif %}
              {% if menu_banner_block.settings.link_label != blank %}
                {% if menu_banner_block.settings.link != blank %}
                  <a class="top-banner__link" href="{{ menu_banner_block.settings.link }}">
                    {{ menu_banner_block.settings.link_label }}
                  </a>
                {% else %}
                  <span class="top-banner__link">{{ menu_banner_block.settings.link_label }}</span>
                {% endif %}
              {% endif %}
            {% else %}
              {% if section.settings.banner_text != blank %}
                <span class="top-banner__text">{{ section.settings.banner_text }}</span>
              {% endif %}
              {% if section.settings.banner_link_label != blank %}
                {% if section.settings.banner_link != blank %}
                  <a class="top-banner__link" href="{{ section.settings.banner_link }}">
                    {{ section.settings.banner_link_label }}
                  </a>
                {% else %}
                  <span class="top-banner__link">{{ section.settings.banner_link_label }}</span>
                {% endif %}
              {% endif %}
            {% endif %}
          </div>
        </div>
      {% endif %}

      <div class="mobile-menu-top">
        <button class="mobile-menu-close" type="button" aria-label="Close menu" data-drawer-close>x</button>
        <div class="mobile-menu-logo">
          {{ header_logo }}
        </div>
        <div class="mobile-menu-icons">
          <a href="/search" class="search-icon" aria-label="Search">{% render 'icon-search' %}</a>
          <a href="#" class="open-cart-drawer" aria-label="Cart">{% render 'icon-shopping-bag' %}</a>
        </div>
      </div>

      <div class="mobile-menu-views">
        <div class="mobile-menu-view mobile-menu-view--root is-active" data-submenu-panel="root">
          <nav class="mobile-menu-nav" aria-label="Mobile">
            <ul class="mobile-menu-list">
              {% for link in linklists[section.settings.left-navbar].links %}
                {% assign link_title_up = link.title | upcase %}
                {% assign link_handle = link.title | handleize %}
                <li class="mobile-menu-item">
                  {% if link.links != blank %}
                    <button
                      class="mobile-menu-link mobile-menu-link--trigger"
                      type="button"
                      data-submenu-open="{{ link_handle }}"
                      aria-label="{{ link.title }}"
                    >
                      <span class="mobile-menu-label{% if link_title_up == 'NEW IN' %} is-new{% endif %}">
                        {{ link.title }}
                      </span>
                      <span class="mobile-menu-chevron" aria-hidden="true">&gt;</span>
                    </button>
                  {% else %}
                    <a href="{{ link.url }}" class="mobile-menu-link">
                      <span class="mobile-menu-label{% if link_title_up == 'NEW IN' %} is-new{% endif %}">
                        {{ link.title }}
                      </span>
                    </a>
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          </nav>
        </div>

        {% for link in linklists[section.settings.left-navbar].links %}
          {% if link.links != blank %}
            {% assign link_handle = link.title | handleize %}
            <div class="mobile-menu-view mobile-menu-view--submenu" data-submenu-panel="{{ link_handle }}">
              <div class="mobile-submenu-header">
                <button class="mobile-submenu-back" type="button" data-submenu-back>
                  <span class="mobile-submenu-arrow" aria-hidden="true">&lt;</span>
                  Back
                </button>
                <span class="mobile-submenu-title">{{ link.title }}</span>
              </div>
              <ul class="mobile-submenu-list">
                {% for child in link.links %}
                  {% if child.links != blank %}
                    {% for sub in child.links %}
                      <li class="mobile-submenu-item">
                        <a href="{{ sub.url }}">{{ sub.title }}</a>
                      </li>
                    {% endfor %}
                  {% else %}
                    <li class="mobile-submenu-item">
                      <a href="{{ child.url }}">{{ child.title }}</a>
                    </li>
                  {% endif %}
                {% endfor %}
              </ul>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <div class="mobile-menu-footer">
        <span class="mobile-menu-locale">
          {{ localization.country.iso_code | default: 'AT' }} / {{ cart.currency.iso_code | default: 'EUR' }}
        </span>
        <a href="/account">Account</a>
      </div>
    </div>
  </div>
</header>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const banner = document.querySelector(".top-banner");
  if (banner) {
    const track = banner.querySelector(".top-banner__track");
    if (track) {
      const items = Array.from(track.children);
      const count = items.length;
      const autoplay = banner.dataset.autoplay === "true";
      const pauseOnHover = banner.dataset.pauseOnHover === "true";
      const interval = Number(banner.dataset.interval) || 4000;
      const transition = Number(banner.dataset.transition) || 600;
      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (count > 1 && autoplay && !prefersReducedMotion) {
        const firstClone = items[0].cloneNode(true);
        firstClone.setAttribute("aria-hidden", "true");
        track.appendChild(firstClone);

        let index = 0;
        let timer = null;
        let itemHeight = banner.clientHeight;

        const updateHeight = () => {
          itemHeight = banner.clientHeight;
          track.style.transform = `translateY(-${index * itemHeight}px)`;
        };

        const moveTo = (i) => {
          track.style.transition = `transform ${transition}ms cubic-bezier(0.2, 0.7, 0, 1)`;
          track.style.transform = `translateY(-${i * itemHeight}px)`;
        };

        const next = () => {
          index += 1;
          moveTo(index);
        };

        track.addEventListener("transitionend", () => {
          if (index === count) {
            track.style.transition = "none";
            index = 0;
            track.style.transform = "translateY(0)";
            void track.offsetHeight;
          }
        });

        const stop = () => {
          if (timer) {
            clearInterval(timer);
            timer = null;
          }
        };

        const start = () => {
          if (timer) return;
          timer = setInterval(next, interval);
        };

        updateHeight();
        window.addEventListener("resize", updateHeight);
        start();

        if (pauseOnHover) {
          banner.addEventListener("mouseenter", stop);
          banner.addEventListener("mouseleave", start);
          banner.addEventListener("focusin", stop);
          banner.addEventListener("focusout", start);
        }
      }
    }
  }

  const header = document.getElementById("site-header");
  const navbar = document.getElementById("navbar");

  function onScroll() {
    if (window.scrollY > 10) {
      header.classList.add("is-scrolled");
      navbar.classList.add("scrolled");
    } else {
      header.classList.remove("is-scrolled");
      navbar.classList.remove("scrolled");
    }
  }

  window.addEventListener("scroll", onScroll);
  onScroll();

  const setActiveSubmenu = (panel, key) => {
    const views = panel.querySelectorAll("[data-submenu-panel]");
    views.forEach((view) => {
      view.classList.toggle("is-active", view.dataset.submenuPanel === key);
    });
    panel.dataset.activeSubmenu = key;
  };

  document.addEventListener("click", (event) => {
    const openTrigger = event.target.closest("[data-submenu-open]");
    if (openTrigger) {
      const panel = openTrigger.closest(".mobile-menu-panel");
      if (!panel) return;
      const targetKey = openTrigger.dataset.submenuOpen;
      if (!targetKey) return;
      setActiveSubmenu(panel, targetKey);
      return;
    }

    const backTrigger = event.target.closest("[data-submenu-back]");
    if (backTrigger) {
      const panel = backTrigger.closest(".mobile-menu-panel");
      if (!panel) return;
      setActiveSubmenu(panel, "root");
    }
  });
});
</script>

