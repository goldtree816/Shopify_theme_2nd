<style>
/* Top banner */
.top-banner {
  position: relative;
  color: white;
  text-align: center;
  font-size: 14px;
  font-weight: bold;
  padding: 5px 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.2);
  z-index: 1;
}

header:hover .top-banner {
  background-color: #a3bfdb;
  color: blue;
  border-bottom: 1px solid rgba(0, 0, 0, 0.2);
  transition: all 0.3s ease;
}

/* Navbar */
.navbar {
  position: relative;
  padding: 15px 40px;
  background-color: transparent;
  transition: all 0.3s ease;
  z-index: 1000;
  height: 70px;
}

.navbar:hover,
.navbar.scrolled {
  background-color: white;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.navbar.scrolled a {
  color: black;
}

.navbar:hover a {
  color: black;
}

/* Left and right navbar */
.nav-left,
.nav-right {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
}

.nav-left {
  left: 40px;
}

.nav-right {
  right: 40px;
  gap: 20px;
}

/* Center logo*/
.nav-center {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
}

.nav-center a {
  color: white;
  text-decoration: none;
}

.navbar:hover .nav-center a,
.navbar.scrolled .nav-center a {
  color: black;
}

/* Navbar links */
.navbar a {
  color: white;
  text-decoration: none;
  margin: 0 {{ section.settings.nav_item_spacing }}px; /* Dynamic spacing */
  font-size: {{ section.settings.nav_font_size }}px; /* Dynamic font size */
  transition: color 0.3s ease;
  position: relative;
}

.navbar a:hover {
  text-decoration: underline;
}

/* Dropdown wrapper */
.nav-item {
  position: relative;
}

/* Full-width dropdown */
.dropdown-menu {
  position: fixed;
  left: 0;
  width: 100vw;
  margin-top: 0px;
  background: white;
  color: black;
  padding: 30px 120px;
  opacity: 0;
  visibility: hidden;
  transform: translateY(-20px);
  transition: opacity 0.4s ease, transform 0.4s ease, visibility 0.4s ease;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
  z-index: 999;
}

.nav-item:hover .dropdown-menu {
  display: flex;
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

/* Dropdown layout */
.dropdown-content {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 80px;
  width: 100%;
}

/* Text links */
.dropdown-columns {
  display: flex;
  gap: 60px;
}

.dropdown-columns ul {
  list-style: none;
  padding: 0;
}

.dropdown-columns li {
  margin-bottom: 10px;
}

.dropdown-columns a {
  color: black;
  font-size: 14px;
  text-decoration: none;
}

.dropdown-columns a:hover {
  text-decoration: underline;
}

/* Dropdown images */
.dropdown-images {
  display: flex;
  gap: 20px;
  width: 750px;
}

.dropdown-images img {
  width: 50%;
  height: 600px;
  object-fit: cover;
  transition: transform 0.3s ease;
}

.dropdown-images img:hover {
  transform: scale(1.03);
}
</style>

<header class="fixed top-0 left-0 w-full z-50">
  <div class="top-banner" style="background-color:{{section.settings.banner_bg_color}};">
     {{ section.settings.banner_text }}
      {% if section.settings.banner_link != blank %}
    <a href="{{ section.settings.banner_link }}" style="color: {{ section.settings.banner_link_color }};">
      <u>{{ section.settings.banner_link_label }}</u>
    </a>
  {% endif %} 
  </div>

  <div class="navbar" id="navbar">
    <!-- LEFT NAV -->
    <nav class="nav-left">
      {% for link in linklists[section.settings.left-navbar].links %}
        <div class="nav-item">
          <a href="{{ link.url }}">{{ link.title }}</a>

          {% if link.links != blank %}
            <div class="dropdown-menu">
              <div class="dropdown-content">
                <div class="dropdown-columns">
                  {% for child in link.links %}
                    <ul>
                      <li><strong>{{ child.title }}</strong></li>
                      {% if child.links != blank %}
                        {% for sub in child.links %}
                          <li><a href="{{ sub.url }}">{{ sub.title }}</a></li>
                        {% endfor %}
                      {% endif %}
                    </ul>
                  {% endfor %}
                </div>

                <div class="dropdown-images">
                  {% for block in section.blocks %}
                    {% if block.settings.menu_title == link.title %}
                      {% if block.settings.image_1 != blank %}
                        <img src="{{ block.settings.image_1 | image_url }}" alt="{{ link.title }} Image 1">
                      {% endif %}
                      {% if block.settings.image_2 != blank %}
                        <img src="{{ block.settings.image_2 | image_url }}" alt="{{ link.title }} Image 2">
                      {% endif %}
                    {% endif %}
                  {% endfor %}
                </div>
              </div>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </nav>

    <!-- CENTER LOGO -->
    <div class="nav-center text-3xl font-bold tracking-widest">
      <a href="{{ routes.root_url }}" class="font-cinzel">{{ shop.name }}</a>
    </div>

    <!-- RIGHT NAV -->
    <nav class="nav-right text-lg font-medium">
      {% for link in linklists[section.settings.right-navbar].links %}
        {% if link.title == "CART" %}
          <a href="{{ link.url }}">&nbsp;{% render 'icon-shopping-bag' %}</a>
        {% endif %}
        <div class="nav-item">
          <a href="{{ link.url }}">{{ link.title }}</a>
        </div>
      {% endfor %}
    </nav>
  </div>
</header>

<script>
window.addEventListener('scroll', function() {
  const navbar = document.getElementById('navbar');
  if (window.scrollY > 10) {
    navbar.classList.add('scrolled');
  } else {
    navbar.classList.remove('scrolled');
  }
});
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type":"text",
      "id":"banner_text",
      "label":"Top Banner Text",
    },
    {
      "type":"text",
      "id":"banner_link_label",
      "label":"Top Banner Link Label",
    },
    {
      "type":"url",
      "id":"banner_link",
      "label":"Top Banner Link",
    },
    {
      "type":"color",
      "id":"banner_bg_color",
      "label":"Top Banner Background Color",
    },
    {
      "type": "color",
      "id": "banner_link_color",
      "label": "Banner Link Color",
      "default": "#FFFFFF"
    },
    

    {
      "type": "link_list",
      "id": "left-navbar",
      "label": "Left Navbar Menu"
    },
    {
      "type": "link_list",
      "id": "right-navbar",
      "label": "Right Navbar Menu"
    },
    {
      "type": "range",
      "id": "nav_item_spacing",
      "label": "Navbar Item Spacing (px)",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 20
    },
    {
      "type": "range",
      "id": "nav_font_size",
      "label": "Navbar Font Size (px)",
      "min": 10,
      "max": 24,
      "step": 1,
      "default": 14
    }
  ],
  "blocks": [
    {
      "type": "menu_images",
      "name": "Menu Item Images",
      "limit": 10,
      "settings": [
        {
          "type": "text",
          "id": "menu_title",
          "label": "Navbar Item Title (must match exactly)"
        },
        {
          "type": "image_picker",
          "id": "image_1",
          "label": "Dropdown Image 1"
        },
        {
          "type": "image_picker",
          "id": "image_2",
          "label": "Dropdown Image 2"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Header"
    }
  ]
}
{% endschema %}
