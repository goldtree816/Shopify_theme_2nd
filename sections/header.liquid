<style>
html {
  overflow-x: hidden;
}
body{
    font-family: 'Manrope', sans-serif;
}
/* Top banner */
.top-banner {
  position: relative;
  color: white;
  text-align: center;
  font-size: 14px;
  font-weight: bold;
  padding: 5px 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.2);
  z-index: 1;
  width:100vw;
}

header:hover .top-banner {
  background-color: #a3bfdb;
  color: blue;
  border-bottom: 1px solid rgba(0, 0, 0, 0.2);
  transition: all 0.3s ease;
}

/* Navbar */
.navbar {
  width:100vw;
  background-color: transparent;
  padding: {{section.settings.navbar_height}}px 40px;
  transition: all 0.3s ease;
  position: relative;
  z-index: 1000;
}

.navbar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  max-width: 1400px;
  margin: 0 auto;
  position: relative;
  align-items: center;

}

.navbar:hover,
.navbar.scrolled {
  background-color: white;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.navbar.scrolled a {
  color: black;
}

.navbar:hover a {
  color: black;
}

/* Left and right navbars */
.nav-left,
.nav-right {
  font-size: {{ section.settings.nav_font_size }}px;
  display: flex;
  align-items: center;
  gap: {{ section.settings.nav_item_spacing }}px;
}

/* Center logo */
.nav-center {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  white-space: nowrap;
  text-align: center;
}

.nav-right svg {
  width: 26px;
  height: 26px;
}

.nav-center a {
  color: white;
  text-decoration: none;
  font-size: {{section.settings.logo_font_size}}px;
}

.navbar:hover .nav-center a,
.navbar.scrolled .nav-center a {
  color: black;
}

/* Navbar links */
.navbar a {
  color: white;
  text-decoration: none;
  transition: color 0.3s ease;
  position: relative;
}

.navbar a:hover {
  text-decoration: underline;
}

/* Dropdown wrapper */
.nav-item {
  position: relative;  
}

/* Full-width dropdown */
.dropdown-menu {
  margin-top:15px;
  position: fixed;
  left: 0;
  width: 100vw;
  background: white;
  color: black;
  padding: 30px 120px;
  opacity: 0;
  visibility: hidden;
  transform: translateY(-20px);
  transition: opacity 0.4s ease, transform 0.4s ease, visibility 0.4s ease;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
  z-index: 999;
}

.nav-item:hover .dropdown-menu {
  display: flex;
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

/* Dropdown layout */
.dropdown-content {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 80px;
  width: 100%;
}

/* Text links */
.dropdown-columns {
  display: flex;
  flex-direction:column;
  gap: 15px;
}

.dropdown-columns ul {
  list-style: none;
  padding: 0;
}

.dropdown-columns li {
  margin-bottom: 10px;
}

.dropdown-columns a {
  color: black;
  font-size: 14px;
  text-decoration: none;
}

.dropdown-columns a:hover {
  text-decoration: underline;
}

/* Dropdown images */
.dropdown-images {
  display: flex;
  gap: 20px;
  width: 750px;
}

.dropdown-images img {
  width: 50%;
  height: 600px;
  object-fit: cover;
  transition: transform 0.3s ease;
}

.dropdown-images img:hover {
  transform: scale(1.03);
}


</style>

<header class="fixed top-0 left-0 w-100vw z-50">
  <div class="top-banner" style="background-color: {{ section.settings.banner_bg_color }};">
    {{ section.settings.banner_text }}
    {% if section.settings.banner_link != blank %}
      <a href="{{ section.settings.banner_link }}" style="color: {{ section.settings.banner_link_color }};">
        <u>{{ section.settings.banner_link_label }}</u>
      </a>
    {% endif %}
  </div>

  <div class="navbar" id="navbar">
    <div class="navbar-inner">
      
      <!-- LEFT NAV -->
      <nav class="nav-left">
        {% for link in linklists[section.settings.left-navbar].links %}
          <div class="nav-item">
            <a href="{{ link.url }}">{{ link.title }}</a>

            {% if link.links != blank %}
              <div class="dropdown-menu">
                <div class="dropdown-content">
                  <div class="dropdown-columns">
                    {% for child in link.links %}
                      <ul>
                        <li><strong>{{ child.title }}</strong></li>
                        {% if child.links != blank %}
                          {% for sub in child.links %}
                            <li><a href="{{ sub.url }}">{{ sub.title }}</a></li>
                          {% endfor %}
                        {% endif %}
                      </ul>
                    {% endfor %}
                  </div>

                  <div class="dropdown-images">
                    {% for block in section.blocks %}
                      {% if block.settings.menu_title == link.title %}
                        {% if block.settings.image_1 != blank %}
                          <img src="{{ block.settings.image_1 | image_url }}" alt="{{ link.title }} Image 1">
                        {% endif %}
                        {% if block.settings.image_2 != blank %}
                          <img src="{{ block.settings.image_2 | image_url }}" alt="{{ link.title }} Image 2">
                        {% endif %}
                      {% endif %}
                    {% endfor %}
                  </div>
                </div>
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </nav>

      <!-- CENTER LOGO -->
      <div class="nav-center">
        <a href="{{ routes.root_url }}" class="font-cinzel font-bold tracking-widest">{{ shop.name }}</a>
      </div>

      <!-- RIGHT NAV -->
      <nav class="nav-right">
        {% for link in linklists[section.settings.right-navbar].links %}

          {% case link.title %}

            {% when "CART" %}
              <a href="#" class="open-cart-drawer cart-icon">{% render 'icon-shopping-bag' %}</a>

            {% when "SEARCH" %}
              <a href="/search" class="nav-icon search-icon">{% render 'icon-search' %}</a>

            {% when "PROFILE" %}
              <a href="/account" class="nav-icon profile-icon">{% render 'icon-profile' %}</a>

            {% else %}
              <div class="nav-item">
                <a href="{{ link.url }}">{{ link.title }}</a>
              </div>

          {% endcase %}

        {% endfor %}
      </nav>

    </div>
  </div>
</header>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const navbar = document.getElementById("navbar");

  function toggleNavbarScroll() {
    if (window.scrollY > 10) {
      navbar.classList.add("scrolled");
    } else {
      navbar.classList.remove("scrolled");
    }
  }

  window.addEventListener("scroll", toggleNavbarScroll);
  toggleNavbarScroll();
});

document.addEventListener('DOMContentLoaded', () => {

  function bindCartDrawerEvents() {
    const overlay = document.querySelector('.cart-overlay');
    if (!overlay) return;

    const closeButton = overlay.querySelector('.cart-drawer-close');
    const drawer = overlay.querySelector('.cart-drawer');
    const openButtons = document.querySelectorAll('.open-cart-drawer');

    // Open drawer from navbar
    openButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        overlay.style.display = 'flex';
        requestAnimationFrame(() => {
          overlay.classList.add('active');
        });
      });
    });

    // Close with X
    if (closeButton) {
      closeButton.addEventListener('click', () => {
        overlay.classList.remove('active');
        setTimeout(() => overlay.style.display = 'none', 300);
      });
    }

    // Close when clicking outside
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) {
        overlay.classList.remove('active');
        setTimeout(() => overlay.style.display = 'none', 300);
      }
    });
  }

  // Run now + run again after section hydration
  bindCartDrawerEvents();

  document.addEventListener('shopify:section:load', bindCartDrawerEvents);
});
</script>


{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "banner_text",
      "label": "Top Banner Text",
      "default": "ENJOY FREE SHIPPING $90."
    },
    {
      "type": "text",
      "id": "banner_link_label",
      "label": "Top Banner Link Label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "banner_link",
      "label": "Top Banner Link"
    },
    {
      "type": "color",
      "id": "banner_bg_color",
      "label": "Top Banner Background Color",
      "default": "#2A3C2D"
    },
    {
      "type": "color",
      "id": "banner_link_color",
      "label": "Banner Link Color",
      "default": "#FFFFFF"
    },
    {
      "type": "link_list",
      "id": "left-navbar",
      "label": "Left Navbar Menu"
    },
    {
      "type": "link_list",
      "id": "right-navbar",
      "label": "Right Navbar Menu"
    },
    {
      "type": "range",
      "id": "nav_item_spacing",
      "label": "Navbar Item Spacing (px)",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 20
    },
    {
      "type": "range",
      "id": "nav_font_size",
      "label": "Navbar Font Size (px)",
      "min": 10,
      "max": 24,
      "step": 1,
      "default": 14
    },
    {
      "type": "range",
      "id": "logo_font_size",
      "label": "Logo Font Size (px)",
      "min": 10,
      "max": 32,
      "step": 1,
      "default": 14
    },
    {
      "type": "range",
      "id": "navbar_height",
      "label": "Navbar Height (px)",
      "min": 5,
      "max": 30,
      "step": 1,
      "default": 15
    },
  ],
  "blocks": [
    {
      "type": "menu_images",
      "name": "Menu Item Images",
      "limit": 10,
      "settings": [
        {
          "type": "text",
          "id": "menu_title",
          "label": "Navbar Item Title (must match exactly)"
        },
        {
          "type": "image_picker",
          "id": "image_1",
          "label": "Dropdown Image 1"
        },
        {
          "type": "image_picker",
          "id": "image_2",
          "label": "Dropdown Image 2"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Header"
    }
  ]
}
{% endschema %}
