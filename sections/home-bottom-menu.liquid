<style>
.bottom-menu {
  display: grid;
  grid-template-columns: 1fr 1fr 1.5fr;
  gap: 8px;
  padding: 100px 0;
  width: 100vw;
}

.bottom-menu .item {
  position: relative;
  overflow: hidden;
}

.bottom-menu img {
  width: 100%;
  height: 680px;
  object-fit: cover;
  transition: transform 0.7s ease;
}

.bottom-menu .item:hover img {
  transform: scale(1.05);
}

.bottom-menu p {
  position: absolute;
  bottom: 20px;
  left: 20px;
  color: white;
  font-size: 1.5rem;
  font-weight: 400;
}

@media (max-width: 768px) {
  .bottom-menu {
    display: grid;
    grid-template-columns: 1fr 1fr; 
    grid-template-rows: auto auto; 
    gap: 6px;
    padding: 20px 0;
  }

  .bottom-menu .item {
    position: relative;
    overflow: hidden;
  }

    .bottom-menu .item:nth-child(1),
  .bottom-menu .item:nth-child(2) {
    aspect-ratio: 3 / 4;
  }
/*3rd section*/
  .bottom-menu .item:nth-child(3) {
    grid-column: 1 / 3; 
  }

  .bottom-menu img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bottom-menu p {
    position: absolute;
    bottom: 15px;
    left: 15px;
    color: white;
    font-size: 1.2rem;
    font-weight: 400;
  }
}

</style>

<section class="bottom-menu">
  {% for block in section.blocks %}
    <div class="item">
      {% if block.settings.image != blank %}
        <img src="{{ block.settings.image | image_url: width: 1500 }}" alt="{{ block.settings.text }}">
      {% endif %}
      {% if block.settings.text != blank %}
        <p>{{ block.settings.text }}</p>
      {% endif %}
    </div>
  {% endfor %}
</section>

{% schema %}
{
  "name": "Home Bottom Menu",
  "settings": [],
  "blocks": [
    {
      "type": "menu_item",
      "name": "Menu Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Menu Image"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Menu Text",
          "default": "Menu Label"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Home Bottom Menu",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}
