<style>
.bottom-menu {
  display: grid;
  grid-template-columns: 1fr 1fr 1.5fr;
  gap: 8px;
  padding: 100px 0;
  width: 100%;
}

.bottom-menu .item {
  position: relative;
  overflow: hidden;
}

.bottom-menu a.item {
  display: block;
  text-decoration: none;
  color: inherit;
}

.bottom-menu img {
  width: 100%;
  height: 680px;
  object-fit: cover;
  transition: transform 0.7s ease;
}

.bottom-menu .item:hover img {
  transform: scale(1.05);
}

.bottom-menu p {
  position: absolute;
  bottom: 20px;
  left: 20px;
  color: white;
  font-size: 1.5rem;
  font-weight: 400;
}

@media (max-width: 768px) {
  .bottom-menu {
    display: grid;
    grid-template-columns: 1fr 1fr; 
    grid-template-rows: auto auto; 
    gap: 6px;
    padding: 20px 0;
  }

  .bottom-menu .item {
    position: relative;
    overflow: hidden;
  }

    .bottom-menu .item:nth-child(1),
  .bottom-menu .item:nth-child(2) {
    aspect-ratio: 3 / 4;
  }
/*3rd section*/
  .bottom-menu .item:nth-child(3) {
    grid-column: 1 / 3; 
  }

  .bottom-menu img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bottom-menu p {
    position: absolute;
    bottom: 15px;
    left: 15px;
    color: white;
    font-size: 1.2rem;
    font-weight: 400;
  }
}

</style>

<section class="bottom-menu">
  {% for block in section.blocks %}
    {% assign menu_collection = block.settings.collection %}
    {% assign item_label = block.settings.text %}

    {% if menu_collection != blank %}
      {% if item_label == blank %}
        {% assign item_label = menu_collection.title %}
      {% endif %}

      {% assign collection_image = menu_collection.image %}
      {% if collection_image == blank and menu_collection.products_count > 0 %}
        {% assign first_product = menu_collection.products.first %}
        {% if first_product != blank and first_product.featured_image != blank %}
          {% assign collection_image = first_product.featured_image %}
        {% endif %}
      {% endif %}

      <a href="{{ menu_collection.url }}" class="item" {{ block.shopify_attributes }}>
        {% if collection_image != blank %}
          <img
            src="{{ collection_image | image_url: width: 1500 }}"
            alt="{{ collection_image.alt | default: item_label | escape }}"
            width="{{ collection_image.width }}"
            height="{{ collection_image.height }}"
            loading="lazy"
          >
        {% endif %}
        {% if item_label != blank %}
          <p>{{ item_label }}</p>
        {% endif %}
      </a>
    {% elsif request.design_mode %}
      <div class="item" {{ block.shopify_attributes }}>
        <p>{{ 'Select a collection' }}</p>
      </div>
    {% endif %}
  {% endfor %}
</section>

{% schema %}
{
  "name": "Home Bottom Menu",
  "settings": [],
  "blocks": [
    {
      "type": "menu_item",
      "name": "Menu Item",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Label override",
          "info": "Optional. Defaults to the selected collection title."
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Home Bottom Menu",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}
