{% assign products_per_page = 12 %}

<section class="shop-all">

<div id="filter-drawer-content" hidden>

  <form method="get" action="{{ collection.url }}" class="filter-form">

    <!-- SORT -->
    <div class="filter-block">
      <h4>Sort by</h4>

      {% for option in collection.sort_options %}
        <label>
          <input
            type="radio"
            name="sort_by"
            value="{{ option.value }}"
            {% if option.value == collection.sort_by %}checked{% endif %}
          >
          {{ option.name }}
        </label>
      {% endfor %}
    </div>

    <!-- FILTERS -->
    {% for filter in collection.filters %}
      <div class="filter-block">
        <h4>{{ filter.label }}</h4>

        {% for value in filter.values %}
          <label>
            <input
              type="checkbox"
              name="{{ value.param_name }}"
              value="{{ value.value }}"
              {% if value.active %}checked{% endif %}
            >
            {{ value.label }}
          </label>
        {% endfor %}
      </div>
    {% endfor %}

    <div class="filter-actions">
      <a href="{{ collection.url }}" class="clear-filters">Clear all</a>
      <button type="submit" class="apply-filters">Apply</button>
    </div>

  </form>

</div>


  <!-- Breadcrumb -->
  <div class="shop-all-breadcrumb">
    <a href="/">Home</a> / <span>Shop All</span>
  </div>

  <!-- Heading -->
  <div class="shop-all-header">
    <h1>{{ collection.title }}</h1>
    {% if collection.description != blank %}
      <p>{{ collection.description }}</p>
    {% endif %}
  </div>


  <nav class="shop-all-nav">
    {% for link in linklists.shop-all.links %}
      <a
        href="{{ link.url }}"
        class="{% if link.url == collection.url %}active{% endif %}"
      >
        {{ link.title }}
      </a>
    {% endfor %}

    <button
      class="filter-button"
      data-drawer-open="#filter-drawer-content"
      data-drawer-title="Filter">
      Filter
    </button>

  </nav>

  <!-- Products -->
  <div class="shop-all-grid">
    {% paginate collection.products by products_per_page %}
      {% for product in collection.products %}
        <div class="shop-all-item">
          {% render 'card', product: product %}
        </div>
      {% endfor %}

      {% if paginate.next %}
        <div class="load-more">
          <a href="{{ paginate.next.url }}">Next</a>
        </div>
      {% endif %}
    {% endpaginate %}
  </div>

</section>

<style>

body{
  font-family: var(--font-primary--family);
  padding-top:70px;
}

body:not(.template-index) .navbar {
  background-color: var(--color-background);
  position: relative;
  border-bottom: 1px solid var(--color-border);
}

body:not(.template-index) .top-banner {
  background-color: var(--color-accent);
  color: var(--color-accent-contrast);
  position: relative;
}

body:not(.template-index) .navbar a{
  color: var(--color-link);
}

.filter-form {
  font-size: 13px;
}

.filter-block {
  margin-bottom: 32px;
}

.filter-block h4 {
  font-size: 13px;
  margin-bottom: 12px;
}

.filter-block label {
  display: block;
  margin-bottom: 8px;
}

.filter-actions {
  display: flex;
  justify-content: space-between;
  margin-top: 40px;
}

.apply-filters {
  background: var(--color-button-bg);
  color: var(--color-button-text);
  border: none;
  padding: 10px 20px;
  cursor: pointer;
}

.clear-filters {
  font-size: 13px;
}


.shop-all {
  max-width: 1500px;
  margin: 0 auto;
  padding: 40px 24px;
}

.shop-all-breadcrumb {
  font-size: 12px;
  color: var(--color-muted);
  margin-bottom: 24px;
}

.shop-all-header h1 {
  font-size: 42px;
  font-weight: 400;
  margin-bottom: 12px;
}

.shop-all-header p {
  max-width: 520px;
  font-size: 14px;
  color: var(--color-muted);
}

.shop-all-nav {
  display: flex;
  align-items: center;
  gap: 28px;
  margin: 40px 0;
  border-bottom: 1px solid var(--color-border);
  padding-bottom: 14px;
}

.shop-all-nav a {
  font-size: 13px;
  color: var(--color-muted);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.shop-all-nav a.active {
  color: var(--color-foreground);
  border-bottom: 2px solid var(--color-foreground);
  padding-bottom: 6px;
}

.filter-button {
  margin-left: auto;
  background: none;
  border: none;
  font-size: 13px;
  cursor: pointer;
}

.shop-all-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 64px 48px;
}

.load-more {
  grid-column: 1 / -1;
  text-align: center;
  margin-top: 80px;
}

.load-more a {
  font-size: 13px;
  color: var(--color-muted);
}


@media (max-width: 900px) {
  .shop-all {
    padding: 32px 16px;
  }

  .shop-all-breadcrumb {
    margin-bottom: 16px;
  }

  .shop-all-header h1 {
    font-size: 30px;
  }

  .shop-all-header p {
    font-size: 13px;
  }

  .shop-all-nav {
    gap: 18px;
    margin: 28px 0;
    overflow-x: auto;
    flex-wrap: nowrap;
    -webkit-overflow-scrolling: touch;
  }

  .shop-all-nav a,
  .shop-all-nav .filter-button {
    white-space: nowrap;
  }

  .shop-all-nav::-webkit-scrollbar {
    display: none;
  }

  .shop-all-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 32px 20px;
  }

  .shop-all .product-card {
    padding-bottom: 6px;
  }

  .shop-all .product-info {
    gap: 16px;
  }

  .shop-all .product-card h3 {
    font-size: 12px;
  }

  .shop-all .price {
    font-size: 13px;
  }

  .shop-all .description {
    font-size: 12px;
  }

  .shop-all .product-rating {
    font-size: 12px;
  }

  .shop-all .product-image {
    display: flex;
    flex-direction: column;
  }

  .shop-all .product-image img {
    height: 320px;
  }

  .shop-all .product-image .add-button {
    position: static;
    transform: none;
    opacity: 1;
    pointer-events: auto;
    margin: 12px 10px 0;
  }
}

@media (max-width: 640px) {
  .shop-all {
    padding: 28px 14px;
  }

  .shop-all-header h1 {
    font-size: 26px;
  }

  .shop-all-nav {
    margin: 24px 0;
  }

  .filter-button {
    margin-left: 0;
  }

  .shop-all-grid {
    grid-template-columns: 1fr;
    gap: 28px;
  }

  .shop-all .product-card {
    padding-bottom: 18px;
  }

  .shop-all .product-image {
    padding: 24px 22px 32px;
    background: #f5f5f5;
  }

  .shop-all .product-image img {
    height: 520px;
    object-fit: contain;
    margin-bottom: 0;
  }

  .shop-all .product-image .add-button {
    display: none;
  }

  .shop-all .product-info {
    align-items: flex-start;
    gap: 16px;
    padding: 12px 10px 0;
  }

  .shop-all .product-card h3 {
    letter-spacing: 0.06em;
  }

  .shop-all .description {
    padding: 4px 10px 0;
    color: var(--color-muted);
  }

  .shop-all .product-rating {
    padding: 4px 10px 0;
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--color-foreground);
  }

  .shop-all .product-rating span {
    letter-spacing: 0;
    margin-left: 4px;
    color: var(--color-muted);
  }

  .shop-all .product-card-cta {
    display: block;
    padding: 10px 10px 0;
  }

  .shop-all .product-card-cta .btn-primary {
    width: 100%;
    height: 38px;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
}

</style>

{% schema %}
{
  "name": "Collection Shop All",
  "settings": []
}
{% endschema %}

