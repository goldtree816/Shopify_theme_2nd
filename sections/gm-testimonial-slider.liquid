            "step": 2,
            "unit": "px",
            "default": 16
        },
        {
            "type": "select",
            "id": "font_weight_title",
            "label": "Font weight title",
            "options": [
                {
                    "value": "400",
                    "label": "Regular"
                },
                {
                    "value": "500",
                    "label": "Semi-bold"
                },
                {
                    "value": "600",
                    "label": "Bold"
                }
            ],
            "default": "400"
        },
        {
            "type": "select",
            "id": "font_weight_text",
            "label": "Font weight text",
            "options": [
                {
                    "value": "400",
                    "label": "Regular"
                },
                {
                    "value": "500",
                    "label": "Semi-bold"
                },
                {
                    "value": "600",
                    "label": "Bold"
                }
            ],
            "default": "400"
        },
        {
            "type": "select",
            "id": "font_weight_rating",
            "label": "Font weight rating",
            "options": [
                {
                    "value": "400",
                    "label": "Regular"
                },
                {
                    "value": "500",
                    "label": "Semi-bold"
                },
                {
                    "value": "600",
                    "label": "Bold"
                }
            ],
            "default": "400"
        }
    ],
    "blocks": [
        {
            "name": "Testimonial Slide",
            "type": "testimonial-slide",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "testimonial_image",
                    "label": "Testimonial image"
                },
                {
                    "type": "text",
