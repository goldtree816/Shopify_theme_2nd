{% render 'bestsellers-snippet',
  heading: section.settings.section_title,
  description: section.settings.section_description,
  gap: section.settings.product_card_spacing,
  collection: section.settings.section_collection
%}

{% schema %}
{
  "name": "Bestsellers",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section title",
      "default": "COLLECTION"
    },
    {
      "type": "range",
      "id": "product_card_spacing",
      "label": "Product card spacing",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 20
    },
    {
      "type": "text",
      "id": "section_description",
      "label": "Section description"
    },
    {
      "type": "collection",
      "id": "section_collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "Bestsellers"
    }
  ]
}
{% endschema %}
