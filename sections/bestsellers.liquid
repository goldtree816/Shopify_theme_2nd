<style>


.heading {
  padding-top: 60px;
  padding-left: 80px;
}
.heading h1 {
  font-size: 36px;
}

.heading p{
  font-weight:400;
  font-size:14px;
}

.bestsellers-product {
  margin: 0 auto;
  align-items: stretch;
  overflow-x: auto;
  display: flex;
  padding-top: 20px;
  width: 90%;
  gap: 20px;
  scroll-snap-type: x mandatory;
  overflow-y:hidden;
}


.bestsellers-product::-webkit-scrollbar {
  display: none;
}

</style>
<div class="heading">
  <h1 class="text-3xl font-sans-500">{{ section.settings.section_title }}</h1>
  <p class="text-sm">{{ section.settings.section_description }}</p>
</div>

<div class="bestsellers-product">
  {% assign collection = collections['bestsellers'] %}
  {% for product in collection.products %}
    {% render 'card', product: product %}
  {% endfor %}
</div>


{% schema %}
{
  "name": "Bestsellers",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "COLLECTION"
    },
    {
      "type": "text",
      "id": "section_description",
      "label": "Section Description",
    }
  ],
  "presets": [
    {
      "name": "Bestsellers"
    }
  ]
}
{% endschema %}
