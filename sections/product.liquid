<style>
body{
  font-family: 'Manrope', sans-serif;
  padding-top:70px;
}

body:not(.template-index) .navbar {
  background-color: white;
  position: relative;
  border-bottom: 1px solid rgba(0,0,0,0.05);
}

body:not(.template-index) .top-banner {
  background-color: lightblue;
  color:pink;
  position: relative;
}

body:not(.template-index) .navbar a{
  color:black;
}

.add-to-bag{
  width:100%;
  display:block;
  
}

.product-section {
  padding: 60px 100px;
}

.breadcrumb {
  font-size: 10px;
  letter-spacing: -0.1px;
  color: #777;
  margin-bottom: 20px;
}

.breadcrumb a {
  color: #777;
  text-decoration: none;
}

.breadcrumb .current {
  font-weight: 600;
  color: #000;
}

.product-container {
  display: flex;
  
  gap: 20px;
}

/* Gallery layout */
.product-gallery {
  display: flex;
  align-items: flex-start;
  gap:5px;
  width:100%;
}

.thumbnail-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
  width: 100px;
}

.thumbnail-list img {
  aspect-ratio:3/4;
  object-fit:cover;
  cursor: pointer;
  opacity: 0.5;
  transition: opacity 0.2s ease, border 0.2s ease;
}

.thumbnail-list img:hover {
  opacity: 1;
}

.thumbnail-list img.active-thumb {
  opacity: 1;
}

.main-image {
  
  width: 500px;
  height: 800px;
  position: relative;
  overflow: hidden;
  flex-shrink: 0;
}

.main-image-inner {
  width: 100%;
  height: 100%;
  display: flex;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
}

.main-image-inner::-webkit-scrollbar {
  display: none;
}

.main-slide {
  
  min-width: 100%;
  height: 100%;
  object-fit: cover;
  scroll-snap-align: start;
  position: relative;
  z-index: 1;
  transition: transform 0.2s ease, transform-origin 0.2s ease;
}

.main-image:hover .main-slide {
  transform: none;
}

.main-image:hover .main-slide.active-slide {
  transform: scale(2);
}


.main-image span {
  position: absolute;
  top: 10px;
  left: 10px;
  background: #edf2fa;
  color: blue;
  font-size: 14px;
  padding: 4px 10px;
  text-transform: uppercase;
  z-index: 10;
}

.main-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 1;
  position: relative;
  transition: transform 0.2s ease, transform-origin 0.2s ease;
}


.main-image:hover img {
  transform: scale(2); /* zoom level */
}


.product-info {
  flex:0.8;
  margin-left:20px;
}

.product-title {
  text-transform: uppercase;
  font-size: 28px;
  font-weight: 400;
  margin-bottom: 8px;
}

.product-reviews {
  font-size: 14px;
  color: #444;
  margin-bottom: 10px;
}

.product-price {
  padding-top:20px;
  font-size: 18px;
  margin-bottom: 10px;
  padding-bottom:40px;
}

.product-tags span {
  margin-top:20px;
  background: #edf2fa;
  color: blue;
  font-size: 14px;
  padding: 4px 10px;
  margin-right: 6px;
  text-transform:uppercase;
}

.product-description {
  font-size: 14px;
  line-height: 1.6;
  margin: 20px 0;
}

.btn-add {
  background-color: #c5d1e2;
  border: none;
  padding: 12px 40px;
  cursor: pointer;
  font-weight: 600;
  border-radius: 30px;
  margin-bottom: 10px;
}

.btn-shop {
width:100;
display:block;
}

.buy-with {
  margin-top: 40px;
}

.buy-with h4 {
  font-size: 14px;
  margin-bottom: 12px;
  font-weight: 600;
}

.stock-status {
  font-size: 10px;
  color: #333;
  display: flex;
  align-items: center;
  justify-content:space-between;
  margin-bottom: 10px;
}

.stock-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  display: inline-block;
}

.stock-dot.in-stock {
  background-color: #3ebd36; /* green dot */
}

.stock-dot.out-of-stock {
  background-color: #c62828; /* red dot */
}

.stock-status.out {
  color: #c62828;
}


.recommended {
  display: flex;
  align-items: center;
  gap: 16px;
}

.recommended img {
  width: 60px;
  border-radius: 4px;
}

.product-accordion {
  margin-top: 40px;
  border-top: 1px solid #dcdcdc;
  font-family: 'Manrope', sans-serif;
}

.product-accordion details {
  border-bottom: 1px solid #dcdcdc;
  padding: 16px 0;
  cursor: pointer;
}

.product-accordion summary {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 14px;
  font-weight: 500;
  color: #222;
  list-style: none;
}

.product-accordion summary::-webkit-details-marker {
  display: none;
}

.product-accordion summary::after {
  content: "+";
  font-size: 18px;
  transition: transform 0.2s ease;
  color: #777;
}

.product-accordion details[open] summary::after {
  content: "−";
  transform: rotate(180deg);
}

.product-accordion .accordion-content {
  font-size: 14px;
  color: #555;
  line-height: 1.6;
  padding-top: 12px;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(-4px); }
  to { opacity: 1; transform: translateY(0); }
}
</style>

<section class="product-section">
  <nav class="breadcrumb">
    <a href="{{ routes.root_url }}">HOME</a>
    <span>/</span>
    <span class="current">{{ product.title | upcase }}</span>
  </nav>

  <div class="product-container">

    <!-- LEFT SIDE Image gallery -->
    <div class="product-gallery">
      <!-- Thumbnails -->
      <div class="thumbnail-list">
        {% for image in product.images %}
          <img 
            src="{{ image | img_url: '200x200' }}" 
            alt="{{ image.alt | escape }}" 
            class="thumbnail {% if forloop.first %}active-thumb{% endif %}"
            data-index="{{ forloop.index0 }}"
          >
        {% endfor %}
      </div>

      <!-- Main image -->
      <div class="main-image">
        <div class="main-image-inner">
          {% for image in product.images %}
            <img
              src="{{ image | img_url: '800x800' }}"
              alt="{{ image.alt | escape }}"
              class="main-slide"
              data-index="{{ forloop.index0 }}"
            >
          {% endfor %}
        </div>

        {% if product.compare_at_price > product.price %}
          <span class="badge badge-sale">Sale</span>
        {% endif %}

        {% if product.tags contains 'new' %}
          <span class="badge badge-new">New</span>
        {% endif %}

        {% if product.tags contains 'bestseller' %}
          <span class="badge badge-bestseller">Bestseller</span>
        {% endif %}
      </div>


    <!-- RIGHT SIDE: Product info -->
    <div class="product-info">
      <div class="stock-status">
        <h1 class="product-title">{{ product.title }}</h1>
        <div>
            {% assign v = product.selected_or_first_available_variant %}
            {% if v.available %}
              <span class="stock-dot in-stock"></span> In stock
            {% else %}
              <span class="stock-dot out-of-stock"></span> Out of stock
            {% endif %}
            </div>
          </div>
        <div class="product-price">{{ product.price | money }}</div>

      <div class="product-tags">
        {% for tag in product.tags %}
          <span>{{ tag }}</span>
        {% endfor %}
      </div>

      <div class="product-description">
        <p>SKIN TYPES: Dry Skin, Normal Skin, Cracked Skin</p>
        <p>{{ product.description }}</p>
      </div>

      <div class="add-to-bag">
        <form method="post" action="/cart/add">
          <input type="hidden" name="id" value="{{ product.variants.first.id }}">
          {% render 'button.liquid', text: "ADD TO BAG", class: 'btn-shop' %}
        </form>
      </div>


      <div class="buy-with">
        <h4>BUY IT WITH:</h4>
        <div class="recommended">
          <img src="{{ 'hero-image-2.jpg' | asset_url }}" alt="Nourishing Face Oil">
          <div>
            <strong>NOURISHING FACE OIL</strong>
            <p>€98</p>
          </div>
        </div>
      </div>
    <div class="product-accordion">

      {% if product.metafields.custom.details %}
        <details>
          <summary>DETAILS</summary>
          <div class="accordion-content">
            {{ product.metafields.custom.details }}
          </div>
        </details>
      {% endif %}

      {% if product.metafields.custom.key_ingredients %}
        <details>
          <summary>KEY INGREDIENTS</summary>
          <div class="accordion-content">
            {{ product.metafields.custom.key_ingredients }}
          </div>
        </details>
      {% endif %}

      {% if product.metafields.custom.how_to_use %}
        <details>
          <summary>HOW TO USE</summary>
          <div class="accordion-content">
            {{ product.metafields.custom.how_to_use }}
          </div>
        </details>
      {% endif %}

      {% if product.metafields.custom.product_details %}
        <details>
          <summary>PRODUCT DETAILS</summary>
          <div class="accordion-content">
            {{ product.metafields.custom.product_details }}
          </div>
        </details>
      {% endif %}

      {% if product.metafields.custom.sustainable_packaging %}
        <details>
          <summary>SUSTAINABLE PACKAGING</summary>
          <div class="accordion-content">
            {{ product.metafields.custom.sustainable_packaging }}
          </div>
        </details>
      {% endif %}

    </div>

    </div>
  </div>
</section>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const slider = document.querySelector(".main-image-inner");
  const slides = document.querySelectorAll(".main-slide");
  const thumbnails = document.querySelectorAll(".thumbnail");

  function activateSlide(index) {
    const width = slider.clientWidth;
    slider.scrollTo({
      left: width * index,
      behavior: "smooth"
    });

    slides.forEach(s => s.classList.remove("active-slide"));
    thumbnails.forEach(t => t.classList.remove("active-thumb"));

    slides[index].classList.add("active-slide");
    thumbnails[index].classList.add("active-thumb");
  }

  thumbnails.forEach(thumb => {
    thumb.addEventListener("click", () => {
      const index = Number(thumb.dataset.index);
      if (Number.isNaN(index)) return;
      activateSlide(index);
    });
  });

  // zoom follow on active slide only
  slider.addEventListener("mousemove", e => {
    const active = document.querySelector(".main-slide.active-slide");
    if (!active) return;

    const rect = active.getBoundingClientRect();
    const x = ((e.clientX - rect.left) / rect.width) * 100;
    const y = ((e.clientY - rect.top) / rect.height) * 100;
    active.style.transformOrigin = `${x}% ${y}%`;
  });

  slider.addEventListener("mouseleave", () => {
    const active = document.querySelector(".main-slide.active-slide");
    if (!active) return;
    active.style.transformOrigin = "center center";
    active.style.transform = "none";
  });

  // set initial active slide
  if (slides.length) {
    slides[0].classList.add("active-slide");
  }
});
</script>





{% schema %}
{
  "name": "Product Page Section",
  "settings": [],
  "presets": [
    {
      "name": "Product Page Section",
      "category": "Product"
    }
  ]
}
{% endschema %}
