<div id="search-overlay" class="search-overlay">
  <div class="search-inner">

    <!-- Search bar -->
    <form action="/search" method="get" class="search-bar">
      <span class="search-input-icon" aria-hidden="true">
        {% render 'icon-search' %}
      </span>
      <input
        id="search-input"
        type="text"
        name="q"
        placeholder="Search"
        class="search-input"
      >
      <button type="button" class="search-close" aria-label="Close search">x</button>
    </form>

    <div class="search-content">

      <!-- Recommended Searches -->
      <div class="recommended-searches">
        <h3>{{ section.settings.search_heading }}</h3>

        <ul id="search-suggestions">
        {% for block in section.blocks %}
            {% if block.type == 'search_term' %}
            <li class="suggestion-item">{{ block.settings.term }}</li>
            {% endif %}
        {% endfor %}
        </ul>

      </div>

{% if section.settings.show_products %}
  <div class="recommended-products-wrapper">
    {% if section.settings.products_collection != blank %}
      {% render 'bestsellers-snippet',
        heading: section.settings.products_subheading,
        description: section.settings.products_description,
        gap: section.settings.products_gap,
        collection: section.settings.products_collection
      %}
    {% else %}
      <p>Select a collection to show products.</p>
    {% endif %}
  </div>
{% endif %}

</div>
        </div>
    </div>

  </div>
</div>

<style>

.search-products-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 25px;
}

.search-product-card img {
  width: 100%;
  border-radius: 8px;
  margin-bottom: 8px;
}


.search-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.3);
  backdrop-filter: blur(3px);
  z-index: 9999;
  display: none;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.search-overlay.active {
  display: flex;
  justify-content: flex-end;
  opacity: 1;
}

/* Floating white search box */
.search-inner {
  width: min(880px, 80vw);
  background: var(--color-background);
  padding: 72px 52px;
  border-radius: 0;
  box-shadow: 0 10px 40px rgba(0,0,0,0.1);
  font-family: var(--font-primary--family);
  max-height: 100vh;
  overflow-y: auto;
}


/* Search top bar */
.search-bar {
  display: grid;
  grid-template-columns: 18px 1fr 28px;
  gap: 12px;
  align-items: center;
  margin-bottom: 36px;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--color-border);
}

.search-input-icon svg {
  width: 18px;
  height: 18px;
  color: var(--color-foreground);
}

.search-input {
  width: 100%;
  font-size: 18px;
  padding: 6px 0;
  border: none;
}

.search-input:focus {
  outline: none;
}

.search-close {
  font-size: 20px;
  background: none;
  border: none;
  cursor: pointer;
  color: var(--color-foreground);
  line-height: 1;
}

/* Layout grid like AEVI */
.search-content {
  display: grid;
  grid-template-columns: 280px 1fr;
  gap: 60px;
}

.recommended-searches h3,
.recommended-products h3 {
  font-size: 16px;
  margin-bottom: 20px;
}

.recommended-searches ul {
  list-style: none;
  padding: 0;
}

.recommended-searches li {
  margin-bottom: 10px;
}

.recommended-searches a {
  color: var(--color-link);
  font-size: 14px;
  text-decoration: none;
}

.recommended-searches a:hover {
  color: var(--color-link-hover);
  text-decoration: underline;
}

.recommended-products-wrapper {
  display: block;
}
.recommended-products-wrapper .bestsellers-product {
  width: 100%
}

@media (max-width: 1024px) {
  .search-inner {
    width: 86vw;
    padding: 56px 36px;
  }
}

@media (max-width: 640px) {
  .search-inner {
    width: 88vw;
    padding: 36px 20px;
  }

  .search-content {
    grid-template-columns: 1fr;
    gap: 32px;
  }

  .search-products-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }
}

</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const overlay = document.getElementById('search-overlay');
  if (!overlay) return;

  const searchButtons = document.querySelectorAll('.search-icon');
  const closeBtn = overlay.querySelector('.search-close');
  const searchInput = overlay.querySelector('#search-input');
  const suggestionItems = overlay.querySelectorAll('#search-suggestions .suggestion-item');
  const productsWrapper = overlay.querySelector('.recommended-products-wrapper');
  const initialProductsMarkup = productsWrapper ? productsWrapper.innerHTML : '';

  const openOverlay = () => {
    overlay.classList.add('active');
    if (searchInput) {
      searchInput.focus();
    }
  };

  const closeOverlay = () => {
    overlay.classList.remove('active');
  };

  searchButtons.forEach(btn => {
    btn.addEventListener('click', e => {
      e.preventDefault();
      openOverlay();
    });
  });

  if (closeBtn) {
    closeBtn.addEventListener('click', closeOverlay);
  }

  overlay.addEventListener('click', e => {
    if (e.target === overlay) {
      closeOverlay();
    }
  });

  if (!searchInput) return;

  searchInput.addEventListener('input', () => {
    const query = searchInput.value.trim().toLowerCase();

    suggestionItems.forEach(item => {
      const text = item.textContent.toLowerCase();
      item.style.display = text.includes(query) ? 'block' : 'none';
    });

    if (!productsWrapper) return;

    if (query.length < 2) {
      productsWrapper.innerHTML = initialProductsMarkup;
      return;
    }

    fetch(`/search/suggest.json?q=${encodeURIComponent(query)}&resources[type]=product&resources[limit]=6`)
      .then(res => res.json())
      .then(data => {
        const products = data.resources.results.products;

        if (!products.length) {
          productsWrapper.innerHTML = '<p>No products found</p>';
          return;
        }

        let html = '<div class="search-products-grid">';
        products.forEach(p => {
          html += `
            <a href="${p.url}" class="search-product-card">
              <img src="${p.image}" alt="${p.title}">
              <p>${p.title}</p>
              <span>${p.price}</span>
            </a>
          `;
        });
        html += '</div>';

        productsWrapper.innerHTML = html;
      })
      .catch(() => {
        productsWrapper.innerHTML = '<p>No products found</p>';
      });
  });
});
</script>

{% schema %}
{
  "name": "Search Overlay",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_products",
      "label": "Show recommended products",
      "default": true
    },
    {
      "type": "header",
      "content": "Recommended Products"
    },
    {
      "type": "collection",
      "id": "products_collection",
      "label": "Collection to display"
    },
    {
      "type": "text",
      "id": "products_subheading",
      "label": "Products subheading",
      "default": "Bestsellers for you"
    },
    {
      "type": "text",
      "id": "products_description",
      "label": "Products description",
      "default": "Description here"
    },
    {
      "type": "range",
      "id": "products_gap",
      "label": "Product card spacing",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 20
    },
    {
      "type": "text",
      "id": "search_heading",
      "label": "Recommended Searches Heading",
      "default": "RECOMMENDED SEARCHES"
    },
    {
      "type": "text",
      "id": "products_heading",
      "label": "Recommended Products Heading",
      "default": "RECOMMENDED PRODUCTS"
    }
  ],
  "blocks": [
    {
      "type": "search_term",
      "name": "Recommended Search Term",
      "settings": [
        {
          "type": "text",
          "id": "term",
          "label": "Term",
          "default": "Bestseller"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Search Overlay"
    }
  ]
}



{% endschema %}
