<section class="about-hero">
  <div class="about-hero-media">

    {% if section.settings.video != blank %}
      <video class="about-hero-video" autoplay muted loop playsinline>
        <source src="{{ section.settings.video | file_url }}" type="video/mp4">
      </video>
    {% elsif section.settings.image != blank %}
      <img class="about-hero-image" src="{{ section.settings.image | img_url: 'master' }}" alt="About Hero">
    {% endif %}

  </div>

  {% if section.settings.heading != blank %}
  <div class="about-hero-content">
    <h1>{{ section.settings.heading }}</h1>
  </div>
  {% endif %}
</section>

<style>
body{
  font-family: var(--font-primary--family);
  padding-top:70px;
}

body:not(.template-index) .navbar {
  background-color: var(--color-background);
  position: relative;
  border-bottom: 1px solid var(--color-border);
}

body:not(.template-index) .top-banner {
  background-color: var(--color-accent);
  color: var(--color-accent-contrast);
  position: relative;
}

body:not(.template-index) .navbar a{
  color: var(--color-link);
}

.about-hero {
  position: relative;
  width: 100%;
  height: 100vh; 
  overflow: hidden;
}

.about-hero-media {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.about-hero-video,
.about-hero-image {
  width: 100%;
  height: 100%;
  object-fit: cover; /* fills perfectly */
}

/* Optional centered heading */
.about-hero-content {
  position: absolute;
  bottom: 10%;
  left: 50%;
  transform: translateX(-50%);
  text-align: center;
  color: white;
}

.about-hero-content h1 {
  font-size: 3rem;
  font-weight: 300;
  margin: 0;
}

/* Mobile */
@media (max-width: 768px) {
  .about-hero {
    height: 80vh;
  }

  .about-hero-content h1 {
    font-size: 2rem;
  }
}
</style>

{% schema %}
{
  "name": "About Hero",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Hero Video (optional)"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Fallback Image (shown if no video)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading Text"
    }
  ],
  "presets": [
    {
      "name": "About Hero"
    }
  ]
}
{% endschema %}
