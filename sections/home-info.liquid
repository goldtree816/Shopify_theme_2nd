<section class="aevi-feature {% if section.settings.layout == 'image-right' %}reverse{% endif %}">
  <div class="aevi-container">
    <div class="aevi-image">
      {% if section.settings.feature_image != blank %}
        <img src="{{ section.settings.feature_image | img_url: 'master' }}" alt="Feature Image">
      {% endif %}
    </div>
    <div class="aevi-content">
      <h2>{{ section.settings.heading }}</h2>
      <div class="aevi-description">
        {{ section.settings.description }}
      </div>
      {% if section.settings.button_text != blank %}
        <a href="{{ section.settings.button_link }}" class="aevi-btn">{{ section.settings.button_text }}</a>
      {% endif %}
    </div>
  </div>
</section>

<style>
.aevi-feature {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 80px 5%;
  gap: 60px;
}
.aevi-feature.reverse .aevi-container {
  flex-direction: row-reverse;
}
.aevi-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 60px;
  width: 100%;
}
.aevi-image img {
  width: 100%;
  max-width: 550px;
  height: auto;
  object-fit: cover;
}
.aevi-content {
  max-width: 500px;
}
.aevi-content h2 {
  font-size: 32px;
  margin-bottom: 15px;
}
.aevi-description p {
  color: #555;
  font-size: 16px;
  line-height: 1.6;
}
.aevi-btn {
  display: inline-block;
  margin-top: 20px;
  font-size: 14px;
  color: #000;
  text-decoration: underline;
}
@media (max-width: 768px) {
  .aevi-feature {
    flex-direction: column;
    text-align: center;
  }
  .aevi-container {
    flex-direction: column !important;
  }
  .aevi-image {
    margin-bottom: 40px;
  }
}
</style>

{% schema %}
{
  "name": "AEVI Feature Section",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Image Position",
      "default": "image-left",
      "options": [
        { "value": "image-left", "label": "Image on Left" },
        { "value": "image-right", "label": "Image on Right" }
      ]
    },
    {
      "type": "image_picker",
      "id": "feature_image",
      "label": "Feature Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Aevi is made with pure, therapeutic ingredients from Nordic nature. Our performance-driven formulas are clinically tested to ensure efficacy and visible results while still being gentle for sensitive skin.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "READ MORE"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "AEVI Feature Section"
    }
  ]
}
{% endschema %}
