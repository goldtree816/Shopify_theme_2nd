{% comment %}
  Section: Hero 13
  Version: 1.0.0
  
  ===================================================
  IMPORTANT - PLEASE READ BEFORE MODIFYING THIS FILE
  ===================================================
  
  This is a Pent Library section template. 
  - Please report bugs to support@pentlibrary.com. Include the section ID and version in the email.
  - Modifying the file may break the section, edit at own risk
  - For best practices, visit our docs: https://www.pentlibrary.com/docs

{% endcomment %}

{%  stylesheet %} 
.--pl--hero-13-padding-left-group {
  padding-left: 5vw !important;
}

@media screen and (max-width: 768px) {
  .--pl--hero-13-padding-left-group {
    padding-left: 5% !important;
    padding-right: 5% !important;
  }
}
{% endstylesheet %}

{% style %}
  .pl--hero-13-bg-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
  }

  .pl--hero-13-inline-padding-{{ section.id }} {
    {% if section.settings.padding_left != 0 and section.settings.padding_left != blank %}
      padding-left: {{ section.settings.padding_left | abs | append: 'px' }};
    {% endif %}
    {% if section.settings.padding_right != 0 and section.settings.padding_right != blank %}
      padding-right: {{ section.settings.padding_right | abs | append: 'px' }};
    {% endif %}
  }

  .pl--hero-13-container-{{ section.id }} {
    {% if section.settings.max_width > 220 and section.settings.max_width != blank %}
      max-width: {{ section.settings.max_width | abs | append: 'px' }};
    {% endif %}
    height: 100%;
  }

  .pl--hero-13-custom-padding-{{ section.id }} {
    {% if section.settings.padding_top != 0 and section.settings.padding_top != blank %}
      padding-top: {{ section.settings.padding_top | abs | append: 'px' }};
    {% endif %}
    {% if section.settings.padding_bottom != 0 and section.settings.padding_bottom != blank %}
      padding-bottom: {{ section.settings.padding_bottom | abs | append: 'px' }};
    {% endif %}
  }

  .pl--hero-13-grid-{{ section.id }} {
    display: grid;
    grid-auto-columns: 1fr;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto;
    align-items: center;
    {% if section.settings.height == "fill" %}
      min-height: 100vh;
      align-content: stretch;
      flex-wrap: wrap;
    {% endif %}
  }

  @media screen and (max-width: 768px) {

    .pl--hero-13-bg-{{ section.id }} {
      {% if section.settings.height_mob == "fill" %}
        min-height: 100vh;
        display: flex;
        align-content: {{ section.settings.align_content_mob }};
        flex-wrap: wrap;
      {% endif %}
    }

    .pl--hero-13-inline-padding-{{ section.id }} {
      {% if section.settings.padding_left_mob != 0 and section.settings.padding_left_mob != blank %}
        padding-left: {{ section.settings.padding_left_mob | abs | append: 'px' }};
      {% endif %}
      {% if section.settings.padding_right_mob != 0 and section.settings.padding_right_mob != blank %}
        padding-right: {{ section.settings.padding_right_mob | abs | append: 'px' }};
      {% endif %}
    }

    .pl--hero-13-custom-padding-{{ section.id }} {
      {% if section.settings.padding_top_mob != 0 and section.settings.padding_top_mob != blank %}
        padding-top: {{ section.settings.padding_top_mob | abs | append: 'px' }};
      {% endif %}
      {% if section.settings.padding_bottom_mob != 0 and section.settings.padding_bottom_mob != blank %}
        padding-bottom: {{ section.settings.padding_bottom_mob | abs | append: 'px' }};
      {% endif %}
    }

    .pl--hero-13-grid-{{ section.id }} {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

<div class="--pl--section-wrapper pl--hero-13-bg-{{ section.id }}">
  <div class="pl--hero-13-container-{{ section.id }}">
    <div class="pl--hero-13-grid-{{ section.id }} pl--hero-13-custom-padding-{{ section.id }} pl--hero-13-inline-padding-{{ section.id }}">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

