}

body:not(.template-index) .navbar {
  background-color: white;
  position: relative;
  border-bottom: 1px solid rgba(0,0,0,0.05);
}

body:not(.template-index) .top-banner {
  background-color: lightblue;
  color:pink;
  position: relative;
}

body:not(.template-index) .navbar a{
  color:black;
}
/* Container */
.search-container {
  width: 100%;
  max-width: 1400px;
  margin: 0 auto;
  padding: 60px;
  font-family: 'Manrope', sans-serif;
}

/* Heading */
.search-heading {
  font-size: 34px;
  font-weight: 400;
  letter-spacing: 1px;
  margin-bottom: 50px;
  text-transform: uppercase;
}

/* Grid */
.search-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 60px;
}

/* Wrapper (needed for badges) */
.product-card-wrapper {
  position: relative;
}

/* Badges */
.badge {
  position: absolute;
  top: 10px;
  left: 10px;
  background: #dbe4f8;
  color: #1d2f50;
  padding: 5px 12px;
  font-size: 11px;
  font-weight: 600;
  border-radius: 4px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  z-index: 5;
}

.badge.sale {
  background: #e4efff;
  color: #003b8e;
}

.badge.oos {
  background: #f1f1f1;
  color: #5a5a5a;
}
</style>

<div class="search-container">

  <!-- Search keyword -->
  <h1 class="search-heading">
    Search “{{ search.terms }}”
  </h1>

  <!-- No results -->
  {% if search.results_count == 0 %}
    <p>No products found.</p>
  {% endif %}

  <!-- Product Grid -->
  <div class="search-grid">

    {% for item in search.results %}
      {% if item.object_type == 'product' %}

      <div class="product-card-wrapper">

        <!-- OUT OF STOCK badge -->
        {% if item.available == false %}
          <div class="badge oos">Out of stock</div>
        {% endif %}

        <!-- SALE badge -->
        {% if item.compare_at_price > item.price %}
          <div class="badge sale">
            Save {{ item.compare_at_price | minus: item.price | money_without_trailing_zeros }}
          </div>
        {% endif %}

        <!-- BESTSELLER badge -->
        {% if item.tags contains 'bestseller' %}
          <div class="badge">Bestseller</div>
        {% endif %}

        <!-- Product card -->
        {% render 'card', product: item %}

      </div>

      {% endif %}
    {% endfor %}

  </div>

</div>
