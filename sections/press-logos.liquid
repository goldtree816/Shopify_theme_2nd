<section class="press-logos">
  <div class="press-logos-container">
    <div class="press-logos-track" id="pressLogosTrack">
      {% for block in section.blocks %}
        {% if block.settings.logo_image != blank %}
          <span><img src="{{ block.settings.logo_image | image_url: width: 200 }}" alt="{{ block.settings.alt_text }}"></span>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<style>

.press-logos {

  background: blue;
  padding: 20px 0;
  overflow: hidden;
  position: relative;
}

.press-logos-container {
  width: 100%;
  overflow: hidden;
  position: relative;
}

.press-logos-track {
  display: flex;
  justify-content: space-evenly;
  align-items: center;
  flex-wrap: nowrap;
  min-width: 100%;
  will-change: transform;
}

.press-logos img {
  max-height: 48px;
  width: auto;
  object-fit: contain;
  flex-shrink: 0;
}

/* Optional: pause scrolling on hover if using CSS animation somewhere */
.press-logos:hover .press-logos-track {
  animation-play-state: paused;
}

</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const track = document.getElementById('pressLogosTrack');
  if (!track) return;

  // Clone logos so it loops smoothly
  const clone = track.cloneNode(true);
  track.parentNode.appendChild(clone);

  let position = 0;
  const speed = 0.3;

  function scroll() {
    position -= speed;
    if (Math.abs(position) >= track.scrollWidth) position = 0;
    track.style.transform = `translateX(${position}px)`;
    clone.style.transform = `translateX(${position + track.scrollWidth}px)`;
    requestAnimationFrame(scroll);
  }

  scroll();
});
</script>

{% schema %}
{
  "name": "Press Logos",
  "settings": [],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo_image",
          "label": "Logo Image"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt Text",
          "default": "Brand Logo"
        }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [
    {
      "name": "Press Logos",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}