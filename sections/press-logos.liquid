<section class="press-logos">
  <div class="press-logos-container">
    <div class="press-logos-wrapper">
      <div class="press-logos-track" id="pressLogosTrack">
        {% for block in section.blocks %}
          {% if block.settings.logo_image != blank %}
            <span><img src="{{ block.settings.logo_image | image_url: width: 200 }}" alt="{{ block.settings.alt_text }}"></span>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<style>
.press-logos {
  background: blue;
  padding: 20px 0;
  overflow: hidden;
  position: relative;
}

.press-logos-container {
  width: 100%;
  overflow: hidden;
  position: relative;
}

.press-logos-wrapper {
  display: flex;
  width: max-content;
}

.press-logos-track {
  display: flex;
  justify-content: space-evenly;
  align-items: center;
  gap: clamp(40px, 8vw, 100px);
  flex-wrap: nowrap;
  will-change: transform;
}

.press-logos img {
  max-height: 48px;
  width: auto;
  object-fit: contain;
  flex-shrink: 0;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const track = document.getElementById('pressLogosTrack');
  if (!track) return;

  const wrapper = track.parentNode;

  // Remove any old clones if hot reloads occur
  wrapper.querySelectorAll('.press-logos-track.clone').forEach(c => c.remove());

  // Create clone for infinite effect
  const clone = track.cloneNode(true);
  clone.classList.add('clone');
  wrapper.appendChild(clone);

  let position = 0;
  let trackWidth = track.scrollWidth;
  const speed = 0.5;

  // Function to recalc width dynamically
  const recalcWidth = () => {
    trackWidth = track.scrollWidth;
    clone.style.transform = `translateX(${trackWidth}px)`;
  };

  // Resize observer to handle logo count or width changes
  const observer = new ResizeObserver(recalcWidth);
  observer.observe(track);

  // Initialize once layout is stable
  window.addEventListener('load', recalcWidth);

  function animate() {
    position -= speed;
    if (position <= -trackWidth) position = 0;

    // Continuous side-by-side movement
    track.style.transform = `translateX(${position}px)`;
    clone.style.transform = `translateX(${position + trackWidth}px)`;

    requestAnimationFrame(animate);
  }

  animate();
});
</script>



{% schema %}
{
  "name": "Press Logos",
  "settings": [],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo_image",
          "label": "Logo Image"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt Text",
          "default": "Brand Logo"
        }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [
    {
      "name": "Press Logos",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}