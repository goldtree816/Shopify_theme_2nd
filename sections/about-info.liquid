{% render 'home-info-snippet',
  layout: section.settings.layout,
  feature_image: section.settings.feature_image,
  heading: section.settings.heading,
  description: section.settings.description,
  button_text: section.settings.button_text,
  button_link: section.settings.button_link
%}

{% schema %}
{
  "name": "Home Info Section",
  "settings": [
    { "type": "select", "id": "layout", "label": "Layout",
      "options": [
        { "value": "image-left", "label": "Left" },
        { "value": "image-right", "label": "Right" }
      ],
      "default": "image-left"
    },
    { "type": "image_picker", "id": "feature_image", "label": "Image" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "description", "label": "Description" },
    { "type": "text", "id": "button_text", "label": "Button Text" },
    { "type": "url", "id": "button_link", "label": "Button Link" }
  ],
  "presets": [
    { "name": "Home Info Section" }
  ]
}
{% endschema %}
