<style>
.error-404 {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  text-align: center;
  min-height: 80vh;
  background-color: var(--color-surface);
  background-size: cover;
  background-position: center;
}

.error-404 h1 {
  font-family: var(--font-primary--family);
  font-size: 28px;
  font-weight: 500;
  color: var(--color-foreground);
  margin-bottom: 30px;
  letter-spacing: 1px;
}

body:not(.template-index) .navbar {
  background-color: var(--color-background);
  position: relative;
  border-bottom: 1px solid var(--color-border);
}

body:not(.template-index) .top-banner {
  background-color: var(--color-accent);
  color: var(--color-accent-contrast);
  position: relative;
  border-bottom: 1px solid var(--color-border);
}

body:not(.template-index) .navbar a {
  color: var(--color-link);
}
</style>

<section class="error-404" 
  style="background-image: url({{section.settings.error_image | image_url: width: 2000 }});">
  <div class="error-container">
    <h1>{{ section.settings.error_text }}</h1>
    {% render 'button',
      text: settings.button_text,
      link: settings.button_link,
      class: 'back-btn'
    %}

  </div>
</section>

{% schema %}
{
  "name": "404 Page",
  "settings": [
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Back to Home"
    },
    { "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "error_text",
      "label": "404 Error Text",
      "default": "404 PAGE NOT FOUND"
    },
    {
      "type": "image_picker",
      "id": "error_image",
      "label": "404 Error Background Image"
    }
  ]
}
{% endschema %}
