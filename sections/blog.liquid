<style>

body{
  font-family:'Manrope',sans-serif;
  padding-top:70px;
}

.journal-container{
  max-width:1400px;
  margin:0 auto;
  padding:40px 20px;
}

.journal-header{
  text-align:center;
  margin-bottom:20px;
}

.journal-header h1{
  font-size:44px;
  font-weight:400;
}

.journal-categories{
  text-align:center;
  margin-bottom:50px;
}

.journal-categories a{
  margin:0 12px;
  font-size:14px;
  color:#6c6c6c;
  text-transform:uppercase;
}

.journal-categories a.active{
  color:black;
  border-bottom:2px solid black;
  padding-bottom:3px;
}



.featured-grid {
  display: grid;
  grid-template-columns: 1.35fr 1fr;
  gap: 40px;
  margin-bottom: 80px;
}

/* Featured left card */
.card-featured {
  border: 1px solid #e5e5e5;
  padding-bottom: 30px;
}

.card-featured img{
  width:100%;
  height:430px;    /* controls entire featured height */
  object-fit:cover;
  border-radius:2px;
}

.card-featured .card-meta{
  margin-top:18px;
  font-size:12px;
  text-transform:uppercase;
  letter-spacing:1px;
  color:#666;
}

.card-featured .card-title{
  margin-top:8px;
  font-size:32px;
  line-height:1.25;
  text-decoration:none;
  color:black;
}

.card-featured .card-excerpt{
  margin-top:12px;
  font-size:16px;
  color:#555;
  max-width:700px;
  line-height:1.45;
}

/* Right side 2 stacked cards */
.side-stack {
  display: grid;
  grid-template-rows: 1fr 1fr;   /* two equal cards */
  gap: 40px;
}

/* Horizontal card layout */
.card-horizontal {
  display: grid;
  grid-template-columns: 230px auto;
  gap: 20px;
  border: 1px solid #e5e5e5;
  padding: 20px;
  overflow: hidden;
}

.card-horizontal img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.card-horizontal .card-meta{
  font-size:12px;
  text-transform:uppercase;
  letter-spacing:1px;
  color:#666;
}

.card-horizontal .card-title{
  margin-top:4px;
  font-size:24px;
  line-height:1.3;
  color:black;
  text-decoration:none;
}

/* LOWER GRID — 2 columns */
.lower-grid {
  display: grid;
  grid-template-columns: 1.35fr 1fr; /* SAME as the featured grid */
  gap: 40px;
}


</style>


<div class="journal-container">

  <div class="journal-header">
    <h1>{{ blog.title }}</h1>
  </div>

  <div class="journal-categories">
    <a href="{{ blog.url }}" class="active">All</a>
    {% for tag in blog.all_tags %}
      <a href="{{ blog.url }}/tagged/{{ tag | handleize }}">{{ tag }}</a>
    {% endfor %}
  </div>

{% paginate blog.articles by 10 %}


{% assign sorted_articles = blog.articles | sort: "published_at" | reverse %}

{% assign first = sorted_articles[0] %}
{% assign second = sorted_articles[1] %}
{% assign third = sorted_articles[2] %}



<div class="featured-grid">

  <!-- Left: Featured -->
  <div class="card-featured">
    <a href="{{ first.url }}">
      <img src="{{ first.image | image_url: width:2000 }}">
    </a>
    <div class="card-meta">{% for t in first.tags %}{{ t }} {% endfor %}</div>
    <a href="{{ first.url }}" class="card-title">{{ first.title }}</a>
    <div class="card-excerpt">{{ first.excerpt }}</div>
  </div>

  <!-- Right: two equal-height cards -->
  <div class="side-stack">

      <div class="card-horizontal">
        <img src="{{ second.image | image_url: width:900 }}">
        <div>
          <div class="card-meta">{% for t in second.tags %}{{ t }} {% endfor %}</div>
          <a href="{{ second.url }}" class="card-title">{{ second.title }}</a>
        </div>
      </div>

      <div class="card-horizontal">
        <img src="{{ third.image | image_url: width:900 }}">
        <div>
          <div class="card-meta">{% for t in third.tags %}{{ t }} {% endfor %}</div>
          <a href="{{ third.url }}" class="card-title">{{ third.title }}</a>
        </div>
      </div>

  </div>

</div>


<!-- ========================================================= -->
<!-- LOWER 2 COLUMN GRID -->
<!-- ========================================================= -->

<div class="lower-grid">
{% for article in sorted_articles offset:3 %}
  <div class="card-horizontal">
    <img src="{{ article.image | image_url: width:900 }}">
    <div>
      <div class="card-meta">{% for t in article.tags %}{{ t }} {% endfor %}</div>
      <a href="{{ article.url }}" class="card-title">{{ article.title }}</a>
    </div>
  </div>
{% endfor %}
</div>


<!-- PAGINATION -->
{% if paginate.pages > 1 %}
<div style="text-align:center;margin-top:40px;">
  {{ paginate | default_pagination }}
</div>
{% endif %}

{% endpaginate %}

</div>


{% schema %}
{
  "name": "AEVI Journal Layout",
  "settings": []
}
{% endschema %}
