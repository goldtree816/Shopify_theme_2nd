<style>

body{
  font-family: var(--font-primary--family);
  padding-top:70px;
}

body:not(.template-index) .navbar {
  background-color: var(--color-background);
  position: relative;
  border-bottom: 1px solid var(--color-border);
}

body:not(.template-index) .top-banner {
  background-color: var(--color-accent);
  color: var(--color-accent-contrast);
  position: relative;
}

body:not(.template-index) .navbar a{
  color: var(--color-link);
}

.article-wrapper {
  max-width: 1440px;
  margin: 0 auto;
  padding: 60px 40px 100px;
  font-family: var(--font-primary--family);
}

/* back link */

.article-back {
  font-size: 13px;
  text-transform: uppercase;
  letter-spacing: .12em;
  color: var(--color-muted);
  display: inline-flex;
  align-items: center;
  margin-bottom: 30px;
  text-decoration: none;
}

.article-back:hover {
  color: var(--color-foreground);
}

/* hero two column */

.article-hero {
  display: grid;
  grid-template-columns: 30% 70%;
  gap: 40px;
  align-items: stretch;
  margin-bottom: 60px;
}

.article-hero-text h1 {
  font-size: 52px;
  line-height: 1.05;
  font-weight: 400;
  margin-bottom: 20px;
}

.article-date {
  font-size: 14px;
  margin-bottom: 18px;
  color: var(--color-muted);
}

.article-tags {
  font-size: 13px;
  text-transform: uppercase;
  letter-spacing: .12em;
  color: var(--color-muted);
}

.article-tags a {
  color: inherit;
  text-decoration: none;
  margin-right: 8px;
}

.article-hero-image img {
  width: 100%;
  height: 560px;
  object-fit: cover;
  display: block;
}

/* body area */

.article-body {
  max-width: 1100px;
  margin: 60px auto 0;
  font-size: 16px;
  line-height: 1.8;
  color: var(--color-foreground);
}

.article-body p { margin-bottom: 18px; }

.article-body img {
  max-width: 100%;
  height: auto;
  display: block;
  margin: 30px auto;
}

/* image row */

.article-image-row {
  display: flex;
  gap: 24px;
  margin: 40px 0;
}

.article-image-row img {
  width: 50%;
  height: auto;
  object-fit: cover;
}

/* caption */

.article-caption {
  font-size: 14px;
  color: var(--color-muted);
  margin-top: 8px;
}

/* comments styling */

.article-comments {
  max-width: 1100px;
  margin: 60px auto;
}

.comment-item {
  padding: 20px 0;
  border-bottom: 1px solid var(--color-border);
}

.comment-author {
  font-weight: 600;
  margin-bottom: 4px;
}

.comment-date {
  font-size: 13px;
  color: var(--color-muted);
  margin-bottom: 10px;
}

.comment-body {
  font-size: 15px;
  line-height: 1.6;
}

/* comment form */

.article-comment-form {
  max-width: 1100px;
  margin: 60px auto;
}

.article-comment-form input,
.article-comment-form textarea {
  width: 100%;
  padding: 12px;
  margin-bottom: 15px;
  border: 1px solid var(--color-border);
  border-radius: 3px;
}

.article-comment-form button {
  padding: 12px 20px;
  background: var(--color-button-bg);
  color: var(--color-button-text);
  border:none;
  cursor:pointer;
}

/* small screens */

@media (max-width: 900px) {
  .article-wrapper { padding: 40px 20px 70px; }

  .article-hero {
    grid-template-columns: 1fr;
  }

  .article-hero-image img {
    height: 380px;
  }

  .article-hero-text h1 {
    font-size: 36px;
  }

  .article-body { margin-top: 40px; }

  .article-image-row { flex-direction: column; }
  .article-image-row img { width: 100%; }
}

</style>

<div class="article-wrapper">

  <a href="{{ blog.url }}" class="article-back">
    {% if section.settings.back_label != blank %}
      {{ section.settings.back_label }}
    {% else %}
      Back to journal
    {% endif %}
  </a>

  <div class="article-hero">
    <div class="article-hero-text">
      <p class="article-date">
        {{ article.published_at | date: "%B %e, %Y" }}
      </p>

      <h1>{{ article.title }}</h1>

      {% if article.tags.size > 0 %}
        <div class="article-tags">
          {% for tag in article.tags %}
            <a href="{{ blog.url }}/tagged/{{ tag | handleize }}">
              {{ tag }}
            </a>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    {% if article.image %}
      <div class="article-hero-image">
        <img
          src="{{ article.image | image_url: width: 2000 }}"
          alt="{{ article.image.alt | escape }}"
        >
      </div>
    {% endif %}
  </div>

  <div class="article-body rte">
    {{ article.content }}
  </div>

  <!-- COMMENTS SECTION -->
  {% if article.comments_count > 0 %}
    <div class="article-comments">
      <h2>Comments ({{ article.comments_count }})</h2>

      {% for comment in article.comments %}
        <div class="comment-item">
          <p class="comment-author">{{ comment.author }}</p>
          <p class="comment-date">{{ comment.created_at | date: "%B %e, %Y" }}</p>
          <div class="comment-body">{{ comment.content }}</div>
        </div>
      {% endfor %}
    </div>
  {% endif %}

  <!-- COMMENT FORM -->
  <div class="article-comment-form">
    <h3>Leave a comment</h3>

    {% form 'new_comment', article, redirect: article.url %}
      {{ form.errors | default_errors }}

      <input
        type="text"
        name="comment[author]"
        placeholder="Name"
        required
      >

      <input
        type="email"
        name="comment[email]"
        placeholder="Email"
        required
      >

      <textarea
        name="comment[body]"
        placeholder="Comment"
        required
      ></textarea>

      <button type="submit">Submit</button>

      {% if form.posted_successfully? %}
        <p>Your comment has been submitted{% if blog.moderated? %} and is awaiting approval{% endif %}.</p>
      {% endif %}

    {% endform %}
  </div>

</div>

{% schema %}
{
  "name": "Article layout",
  "settings": [
    {
      "type": "text",
      "id": "back_label",
      "label": "Back link label",
      "default": "Back to journal"
    }
  ]
}
{% endschema %}
