<style>
footer {
  width: 100%;
  background-color: #d8dde2;
  color: #222;
  padding: 80px 100px;
  font-family: ui-sans-serif, system-ui, -apple-system;
}

.footer-container {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 80px;
}

.footer-left {
  flex: 1;
  display: flex;
  justify-content: space-between;
}

.footer-logo {
  width: 50px;
  margin-bottom: 40px;
}

.footer-subscribe h4 {
  font-size: 14px;
  font-weight: 600;
  letter-spacing: 1px;
  margin-bottom: 8px;
}

.footer-subscribe p {
  font-size: 14px;
  margin-bottom: 12px;
  max-width: 300px;
}

.subscribe-box {
  display: flex;
  align-items: center;
  gap: 10px;
  border-bottom: 1px solid #000;
  max-width: 250px;
  padding-bottom: 4px;
}

.subscribe-box input {
  border: none;
  background: transparent;
  outline: none;
  flex: 1;
  font-size: 14px;
}

.subscribe-box button {
  background: none;
  border: none;
  font-size: 12px;
  text-transform: uppercase;
  cursor: pointer;
}

.footer-payments {
  margin-top: 40px;
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.footer-payments img {
  height: 24px;
}

.footer-note {
  font-size: 12px;
  margin-top: 40px;
  color: #555;
}

.footer-right {
  display: flex;
  justify-content: space-between;
  gap: {{section.settings.footer-column-gap}}px;
}

.footer-right h4 {
  font-size: 13px;
  text-transform: uppercase;
  font-weight: 600;
  margin-bottom: 12px;
}

.footer-right ul {
  list-style: none;
  padding: 0;
}

.footer-right li {
  margin-bottom: 6px;
  font-size: 14px;
  cursor: pointer;
  transition: color 0.3s ease;
}

.footer-right li:hover {
  color: #2596be;
}
</style>

<footer class="footer">
  {% if section.settings.logo != blank %}
    <img src="{{ section.settings.logo | image_url: width:120 }}" alt="Logo" class="footer-logo">
  {% endif %}

  <div class="footer-container">

    <div class="footer-left">
      <div class="footer-subscribe">
        <h4>{{ section.settings.newsletter_heading }}</h4>
        <p>{{ section.settings.newsletter_text }}</p>

        <div class="subscribe-box">
          <input type="email" placeholder="{{ section.settings.placeholder_text }}">
          <button>{{ section.settings.placeholder_button }}</button>
        </div>

        <div class="footer-payments">
          <img src="{{ 'hero_image_2.jpg' | asset_url }}" alt="Payment Method">
          <img src="{{ 'applepay.svg' | asset_url }}" alt="Apple Pay">
          <img src="{{ 'googlepay.svg' | asset_url }}" alt="Google Pay">
          <img src="{{ 'visa.svg' | asset_url }}" alt="Visa">
          <img src="{{ 'mastercard.svg' | asset_url }}" alt="Mastercard">
        </div>

        <p class="footer-note">{{ section.settings.copyright_text }}</p>
      </div>
    </div>

    <div class="footer-right">

  <!-- First menu -->
  <div>
    <h4>{{ linklists[section.settings.footer-first-column].title }}</h4>
    <ul>
      {% for link in linklists[section.settings.footer-first-column].links %}
        <li><a href="{{ link.url }}">{{ link.title }}</a></li>

        {% if link.links != blank %}
          <ul>
            {% for child in link.links %}
              <li><strong>{{ child.title }}</strong></li>

              {% if child.links != blank %}
                <ul>
                  {% for sub in child.links %}
                    <li><a href="{{ sub.url }}">{{ sub.title }}</a></li>
                  {% endfor %}
                </ul>
              {% endif %}
            {% endfor %}
          </ul>
        {% endif %}
      {% endfor %}
    </ul>
  </div>

  <!-- Second menu -->
  <div>
    <h4>{{ linklists[section.settings.footer-second-column].title }}</h4>
    <ul>
      {% for link in linklists[section.settings.footer-second-column].links %}
        <li><a href="{{ link.url }}">{{ link.title }}</a></li>
      {% endfor %}
    </ul>
  </div>

  <!-- Third menu -->
  <div>
    <h4>{{ linklists[section.settings.footer-third-column].title }}</h4>
    <ul>
      {% for link in linklists[section.settings.footer-third-column].links %}
        <li><a href="{{ link.url }}">{{ link.title }}</a></li>
      {% endfor %}
    </ul>
  </div>

</div>

  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "link_list",
      "id": "footer-first-column",
      "label": "Footer Section First Menu"
    },
    {
      "type": "link_list",
      "id": "footer-second-column",
      "label": "Footer Section Second Menu"
    },
    {
      "type": "link_list",
      "id": "footer-third-column",
      "label": "Footer Section Third Menu"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright Text"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter Heading Text"
    },
    {
      "type": "range",
      "id": "footer-column-gap",
      "label": "Footer Column Gap (px)",
      "min": 0,
      "max": 400,
      "step": 10,
      "default": 100
    },
    {
      "type": "text",
      "id": "placeholder_text",
      "label": "Placeholder Text"
    },
    {
      "type": "text",
      "id": "placeholder_button",
      "label": "Placeholder Button Text"
    },
    {
      "type": "text",
      "id": "newsletter_text",
      "label": "Newsletter Text"
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "Footer"
    }
  ]
}
{% endschema %}
