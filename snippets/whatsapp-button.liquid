<style>
  .whatsapp-button-section {
    margin: 25px 0;
    text-align: {{ block.settings.alignment }};
  }

  .whatsapp-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
    border: none;
    width: 100%;
    max-width: {{ block.settings.container_width }}px;
  }

  .whatsapp-btn:hover {
    opacity: 0.9;
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(0,0,0,0.1);
  }

  .whatsapp-icon {
    margin-right: 10px;
    display: inline-block;
    width: 20px;
    height: 20px;
  }

  @media screen and (max-width: 767px) {
    .whatsapp-btn {
      max-width: 100%;
    }
  }
</style>

<div class="whatsapp-button-section">
  {% if product %}
    {% comment %} On product pages, use product name and price {% endcomment %}
    {% capture product_name %}{{ product.title }}{% endcapture %}
    {% capture product_price %}{{ product.price | money }}{% endcapture %}

    {% assign message_template = block.settings.product_message %}
    {% assign message = message_template
      | replace: '{product_name}', product_name
      | replace: '{product_price}', product_price
    %}
  {% else %}
    {% comment %} On non-product pages, use default message {% endcomment %}
    {% assign message = block.settings.default_message %}
  {% endif %}

  <a
    href="https://wa.me/{{ block.settings.whatsapp_number }}?text={{ message | url_encode }}"
    class="whatsapp-btn"
    target="_blank"
    style="
      background-color: {{ block.settings.button_bg_color }};
      color: {{ block.settings.button_text_color }};
      padding: {{ block.settings.button_padding }}px;
      border-radius: {{ block.settings.button_border_radius }}px;
    "
  >
    <svg class="whatsapp-icon" viewBox="0 0 24 24" fill="currentColor">
