{% style %}
  {% # Loads all font variantions with display: swap %}
  {{ settings.type_primary_font | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}

  :root {
    --font-primary--family: {{ settings.type_primary_font.family }}, {{ settings.type_primary_font.fallback_families }};
    --font-primary--style: {{ settings.type_primary_font.style }};
    --font-primary--weight: {{ settings.type_primary_font.weight }};
    --font-sans: var(--font-primary--family);
    --default-font-family: var(--font-primary--family);
    --color-background: {{ settings.background_color }};
    --color-foreground: {{ settings.foreground_color }};
    --color-muted: {{ settings.muted_text_color }};
    --color-border: {{ settings.border_color }};
    --color-surface: {{ settings.surface_color }};
    --color-accent: {{ settings.accent_color }};
    --color-accent-soft: {{ settings.accent_soft_color }};
    --color-accent-contrast: {{ settings.accent_contrast_color }};
    --color-accent-border: {{ settings.accent_border_color }};
    --color-link: {{ settings.link_color }};
    --color-link-hover: {{ settings.link_hover_color }};
    --color-button-bg: {{ settings.button_bg_color }};
    --color-button-text: {{ settings.button_text_color }};
    --color-button-border: {{ settings.button_border_color }};
    --color-button-hover-bg: {{ settings.button_hover_bg_color }};
    --color-button-hover-text: {{ settings.button_hover_text_color }};
    --color-success: {{ settings.success_color }};
    --color-error: {{ settings.error_color }};
    --page-width: {{ settings.max_page_width }};
    --page-margin: {{ settings.min_page_margin }}px;
    --style-border-radius-inputs: {{ settings.input_corner_radius }}px;
    --primary_text: var(--color-foreground);
    --background_color: var(--color-background);
    --primary_grey: var(--color-muted);
    --secondary_grey: var(--color-border);
    --tertiary_grey: var(--color-surface);
    --primary_accent: var(--color-accent);
    --secondary_accent: var(--color-accent-soft);
    --btn_primary_on_light_bg: var(--color-button-bg);
    --btn_primary_on_light_txt: var(--color-button-text);
    --btn_primary_on_light_border: var(--color-button-border);
    --btn_primary_on_light_bg_hover: var(--color-button-hover-bg);
    --btn_primary_on_light_txt_hover: var(--color-button-hover-text);
    --btn_primary_on_light_border_hover: var(--color-button-border);
    --label_onSale_text: var(--color-accent-contrast);
    --label_onSale_Bg: var(--color-accent);
    --label_soldOut_text: var(--color-muted);
    --label_soldOut_Bg: var(--color-surface);
    --label_custom_text: var(--color-accent-contrast);
    --label_custom_Bg: var(--color-accent-soft);
  }
{% endstyle %}
