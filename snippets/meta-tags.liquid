<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width,initial-scale=1">

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif

  assign meta_description = page_description
  if meta_description == blank
    if request.page_type == 'product' and product
      assign meta_description = product.description | strip_html | strip_newlines | truncate: 160
    elsif request.page_type == 'collection' and collection
      assign meta_description = collection.description | strip_html | strip_newlines | truncate: 160
    elsif request.page_type == 'article' and article
      assign meta_description = article.excerpt_or_content | strip_html | strip_newlines | truncate: 160
    elsif request.page_type == 'blog' and blog
      assign meta_description = blog.title | append: ' | ' | append: shop.name
    elsif request.page_type == 'page' and page
      assign meta_description = page.content | strip_html | strip_newlines | truncate: 160
    endif
  endif
  if meta_description == blank
    assign meta_description = shop.description | default: shop.name
  endif

  assign og_description = page_description | default: meta_description | default: shop.description | default: shop.name

  assign og_image = page_image
  if og_image == blank
    assign og_image = shop.brand.logo
  endif
  if og_image == blank
    assign og_image = settings.logo
  endif

  assign robots_meta = ''
  if request.page_type == 'search'
    assign robots_meta = 'noindex, follow'
  elsif request.page_type == 'cart'
    assign robots_meta = 'noindex, follow'
  elsif request.page_type contains 'customers'
    assign robots_meta = 'noindex, follow'
  elsif request.page_type == 'password'
    assign robots_meta = 'noindex, follow'
  elsif request.page_type == '404'
    assign robots_meta = 'noindex, follow'
  elsif request.page_type == 'gift_card'
    assign robots_meta = 'noindex, follow'
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if og_image -%}
  <meta
    property="og:image"
    content="http:{{ og_image | image_url: width: 1200 }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ og_image | image_url: width: 1200 }}"
  >
  <meta
    property="og:image:width"
    content="{{ og_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ og_image.height }}"
  >
  <meta
    property="og:image:alt"
    content="{{ og_image.alt | default: og_title | escape }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>

  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>
{%- if og_image -%}
  <meta
    name="twitter:image"
    content="https:{{ og_image | image_url: width: 1200 }}"
  >
{%- endif -%}

<title>
  {{ page_title }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

{% if meta_description %}
  <meta
    name="description"
    content="{{ meta_description | escape }}"
  >
{% endif %}

{% unless robots_meta == '' %}
  <meta
    name="robots"
    content="{{ robots_meta }}"
  >
{% endunless %}

{% render 'structured-data' %}
