<style>

.bestsellers-product::-webkit-scrollbar {
  height: 8px; /* thickness */
}

.bestsellers-product::-webkit-scrollbar-track {
  background: var(--color-surface);
  border-radius: 10px;
}

.bestsellers-product::-webkit-scrollbar-thumb {
  background: var(--color-border);
  border-radius: 10px;
  transition: background 0.5s ease;
}

.bestsellers-product { /*for firefox*/
  scrollbar-color: var(--color-border) var(--color-surface);
  scrollbar-width: thin;
}

.heading {
  padding-top: 60px;
  padding-left: 80px;
}
.heading h1 {
  font-size: 36px;
}

.heading p{
  font-weight:400;
  font-size:14px;
}

.bestsellers-product {
  margin: 0 auto;
  align-items: stretch;
  overflow-x: auto;
  display: flex;
  padding-top: 20px;
  width: 90%;
  scroll-snap-type: x mandatory;
  overflow-y:hidden;
  gap: var(--bestsellers-gap, 20px);
}

.bestsellers-product > product-card {
  flex: 0 0 clamp(250px, 19vw, 330px);
  min-width: clamp(250px, 19vw, 330px);
  scroll-snap-align: start;
}

.bestsellers-product::-webkit-scrollbar {
  display: none;
}

@media (max-width: 768px) {
  .heading {
    padding-left: 22px;
    padding-top: 40px;
  }

  .heading h1 {
    font-size: 28px;
  }

  .heading p {
    font-size: 13px;
  }

  .bestsellers-product {
    width: 100%;
    padding: 16px 16px 0;
    --bestsellers-gap: 16px;
  }

  .bestsellers-product > product-card {
    flex: 0 0 calc((100% - (var(--bestsellers-gap, 16px) * 0.0875)) / 1.0875);
    min-width: calc((100% - (var(--bestsellers-gap, 16px) * 0.0875)) / 1.0875);
  }
}

</style>

{%- assign heading_text = heading | default: '' -%}
{%- assign description_text = description | default: '' -%}
{%- assign gap_value = gap | default: 20 -%}



<div class="heading">
  {% if heading_text != '' %}
    <h1 class="text-3xl font-sans-500">{{ heading_text }}</h1>
  {% endif %}
  {% if description_text != '' %}
    <p class="text-sm">{{ description_text }}</p>
  {% endif %}
</div>

<div class="bestsellers-product" style="--bestsellers-gap: {{ gap_value }}px;">
  {% assign selected_collection = collection %}
  {% if selected_collection and selected_collection.products_count > 0 %}
    {% for product in selected_collection.products %}
      {% render 'card', product: product %}
    {% endfor %}
  {% else %}
    <p>No products found.</p>
  {% endif %}
</div>
