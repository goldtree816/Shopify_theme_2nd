<style>
.product-card {
  flex: 0 0 320px;
  scroll-snap-align: start;
  padding-bottom: 10px;
  font-family: var(--font-primary--family);
}

.product-image {
  position: relative;
  overflow: hidden;
}

.product-image a {
  display: block;
}

.product-image img {
  object-fit: cover;
  height: 400px;
  width: 100%;
  margin-bottom: 10px;
  display: block;
}

.product-badge {
  position: absolute;
  top: 12px;
  left: 12px;
  background: var(--color-accent-soft);
  color: var(--color-link-hover);
  font-size: 11px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  padding: 2px 6px;
  border-radius: 2px;
}

.product-image .add-button {
  left: 50%;
  position: absolute;
  bottom: 10px;
  transform: translateX(-50%);
  opacity: 0;
  transition: all 0.3s ease;
  pointer-events: none;
}

.product-card:hover .product-image .add-button {
  opacity: 1;
  pointer-events: auto;
  margin-bottom: 10px;
}

.product-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-left: 10px;
  padding-right: 10px;
  gap: 50px;
}

.product-card h3 {
  font-size: 14px;
  font-weight: 500;
  text-transform: uppercase;
  margin: 0;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: normal;
  max-height: 2.8em;
  line-height: 1.4em;
}

.price {
  display: flex;
  align-items: right;
  justify-content: right;
  font-weight: 600;
  font-size: 14px;
  white-space: nowrap;
}

.description {
  align-items: right;
  justify-content: right;
  font-weight: 350;
  font-size: 14px;
  padding-left: 10px;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: normal;
  max-height: 2.8em;
  line-height: 1.4em;
}

.product-rating {
  padding-left: 10px;
}

.product-rating span {
  letter-spacing: 0;
  margin-left: 4px;
  color: var(--color-muted);
}

.product-card-cta {
  padding: 10px 10px 0;
  display: none;
}

@media (max-width: 768px) {
  .bestsellers-product .product-card {
    flex: 0 0 100%;
    padding-bottom: 18px;
  }

  .bestsellers-product .product-image {
    padding: 24px 22px 32px;
    background: #f5f5f5;
  }

  .bestsellers-product .product-image img {
    height: 520px;
    object-fit: contain;
    margin-bottom: 0;
  }

  .bestsellers-product .product-image .add-button {
    display: none;
  }

  .bestsellers-product .product-info {
    align-items: flex-start;
    gap: 16px;
    padding: 12px 10px 0;
  }

  .bestsellers-product .product-card h3 {
    letter-spacing: 0.06em;
  }

  .bestsellers-product .description {
    padding: 4px 10px 0;
    color: var(--color-muted);
  }

  .bestsellers-product .product-rating {
    padding: 4px 10px 0;
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--color-foreground);
  }

  .bestsellers-product .product-rating span {
    letter-spacing: 0;
    margin-left: 4px;
    color: var(--color-muted);
  }

  .bestsellers-product .product-card-cta {
    display: block;
    padding: 10px 10px 0;
  }

  .bestsellers-product .product-card-cta .btn-primary {
    width: 100%;
    height: 38px;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
}
</style>

<div class="product-card">
  {% assign is_new = false %}
  {% for tag in product.tags %}
    {% assign tag_up = tag | upcase %}
    {% if tag_up == 'NEW' %}
      {% assign is_new = true %}
    {% endif %}
  {% endfor %}

  <div class="product-image">
    <a href="{{ product.url }}">
      <img src="{{ product.featured_image | img_url: 'medium' }}" alt="{{ product.title }}">
    </a>

    {% if is_new %}
      <span class="product-badge">New</span>
    {% endif %}

    <div class="add-button">
      <button
        class="btn-primary quick-add-btn"
        type="button"
        data-variant="{{ product.selected_or_first_available_variant.id }}"
      >
        ADD TO BAG
      </button>
    </div>
  </div>

  <div class="product-info">
    <h3>{{ product.title }}</h3>
    <div class="price">
      <p>{{ product.price | money }}</p>
    </div>
  </div>

  <div class="description">
    <p>{{ product.description | strip_html }}</p>
  </div>

  {% assign rating_value = product.metafields.reviews.rating | default: 0 %}
  {% assign rating_count = product.metafields.reviews.count | default: 0 %}
  {% assign rating_int = rating_value | round %}
  <div class="product-rating">
    {% for i in (1..5) %}
      {% if i <= rating_int %}&#9733;{% else %}&#9734;{% endif %}
    {% endfor %}
    {% if rating_count != 0 %}
      <span>({{ rating_count }})</span>
    {% endif %}
  </div>

  <div class="product-card-cta">
    <button
      class="btn-primary quick-add-btn"
      type="button"
      data-variant="{{ product.selected_or_first_available_variant.id }}"
    >
      ADD TO BAG
    </button>
  </div>
</div>
