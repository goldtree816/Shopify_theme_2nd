<style>
.product-card{
    flex:0 0 400px;
    border: 1px solid #ddd;
    scroll-snap-align: start;
    padding-bottom:100px;
    height:600px;
    font-family:ui-sans-serif, system-ui, -apple-system;
}

.product-info{
    display: flex;
  justify-content: space-between; /* pushes title left, price right */
  align-items: center;   
  padding-left:10px; 
  padding-right:10px; 
}

.price{
    display:flex;
    align-items:right;
    justify-content:right;
    font-weight:600;
    font-size:14px;
}

.product-rating{
    padding-left:10px;
}

h3{
    font-size:16px;
    font-weight:600;
}

.product-image{
  position: relative;
  overflow: hidden;
}

.product-image img{
    object-fit:cover;
    height:450px;
    width:100%;
    margin-bottom:10px;
    display:block;
}



.product-image .add-button {
  left:50%;
  position: absolute;
  bottom: 10px;
  transform: translateX(-50%);
  opacity: 0;
  transition: all 0.3s ease;
  pointer-events: none;
}


.product-card:hover .product-image .add-button {
  opacity: 1;
  pointer-events: auto;
  margin-bottom:10px;
}

</style>
<div class="product-card">
<a href="{{product.url}}">
    <div class="product-image">
        <img src="{{product.featured_image | img_url: 'medium'}}" alt="{{product.title}}">
        <div class="add-button">
         {% render 'button',
        text: 'ADD TO BAG',
        %}
        </div>
    </div>
<div class="product-info">
    <h3>{{product.title}}</h3>
    <div class="price">
    <p>{{product.price | money}}</p>
    </div>
</div>
<div class="product-rating">
  {% for i in (1..5) %}
    {% if i <= product.metafields.reviews.rating %}
      ★
    {% else %}
      ☆
    {% endif %}
  {% endfor %}
  <span>{{ product.metafields.reviews.count }}</span>
</div>
</a>

</div>

