<style>
.body{
    font-family: 'Manrope', sans-serif;
}
.product-card{
    flex:0 0 320px;
    scroll-snap-align: start;
    padding-bottom:10px;
    font-family:ui-sans-serif, system-ui, -apple-system;
}

.product-info{
    display: flex;
  justify-content: space-between;
  align-items: center;   
  padding-left:10px; 
  padding-right:10px; 
  gap:50px;
}

.price{
    display:flex;
    align-items:right;
    justify-content:right;
    font-weight:600;
    font-size:14px;
}

.description{
    align-items:right;
    justify-content:right;
    font-weight:350;
    font-size:14px;
    padding-left:10px;
    display: -webkit-box;
   -webkit-box-orient: vertical;
   -webkit-line-clamp: 1;    
   overflow: hidden;
   text-overflow: ellipsis;
   white-space: normal;      
   max-height: 2.8em;        
   line-height: 1.4em;
} 


.product-rating{
    padding-left:10px;
}

h3{
    font-size:14px;
    font-weight:500;
    text-transform: uppercase;
        display: -webkit-box;
   -webkit-box-orient: vertical;
   -webkit-line-clamp: 2;    
   overflow: hidden;
   text-overflow: ellipsis;
   white-space: normal;      
   max-height: 2.8em;        
   line-height: 1.4em;
}

.product-image{
  position: relative;
  overflow: hidden;
}

.product-image img{
    object-fit:cover;
    height:400px;
    width:100%;
    margin-bottom:10px;
    display:block;
}



.product-image .add-button {
  left:50%;
  position: absolute;
  bottom: 10px;
  transform: translateX(-50%);
  opacity: 0;
  transition: all 0.3s ease;
  pointer-events: none;
}


.product-card:hover .product-image .add-button {
  opacity: 1;
  pointer-events: auto;
  margin-bottom:10px;
}

</style>
<div class="product-card">

  <div class="product-image">
    <a href="{{ product.url }}">
      <img src="{{product.featured_image | img_url: 'medium'}}" alt="{{product.title}}">
    </a>

    <div class="add-button">
      <button  class="btn-primary quick-add-btn"data-variant="{{ product.variants.first.id }}">
        ADD TO BAG
      </button>


    </div>
  </div>

 



  <div class="product-info">
    <h3>{{product.title}}</h3>
    <div class="price">
      <p>{{product.price | money}}</p>
    </div>
  </div>

  <div class="description">
    <p>{{product.description}}</p>
  </div>

  <div class="product-rating">
    {% for i in (1..5) %}
      {% if i <= product.metafields.reviews.rating %} ★ {% else %} ☆ {% endif %}
    {% endfor %}
    <span>{{ product.metafields.reviews.count }}</span>
  </div>

</div>


<script>

document.addEventListener("DOMContentLoaded", () => {
  document.querySelectorAll('.quick-add-btn').forEach(btn => {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();

      const id = this.dataset.variant;

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: id, quantity: 1 })
      })
      .then(r => r.json())
      .then(data => {
        const overlay = document.querySelector('.cart-overlay');
        overlay.style.display = 'flex';
        setTimeout(() => { overlay.classList.add('active'); }, 10);
      });
    });
  });
});
</script>
