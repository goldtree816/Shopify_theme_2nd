{%- liquid
  assign shop_url = request.origin
  assign logo_image = shop.brand.logo
  if logo_image == blank
    assign logo_image = settings.logo
  endif
-%}
{%- capture search_action_target -%}{{ shop_url }}{{ routes.search_url }}?q={search_term_string}{%- endcapture -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": {{ shop.name | json }},
  "url": {{ shop_url | json }}{% if logo_image %},
  "logo": {{ logo_image | image_url: width: 600 | json }}{% endif %}
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": {{ shop.name | json }},
  "url": {{ shop_url | json }},
  "potentialAction": {
    "@type": "SearchAction",
    "target": {{ search_action_target | json }},
    "query-input": "required name=search_term_string"
  }
}
</script>

{%- assign show_breadcrumbs = false -%}
{%- assign breadcrumb_items = "" -%}
{%- capture breadcrumb_items -%}
{
  "@type": "ListItem",
  "position": 1,
  "name": "Home",
  "item": {{ shop_url | json }}
}
{%- endcapture -%}

{%- case request.page_type -%}
  {%- when 'collection' -%}
    {%- assign show_breadcrumbs = true -%}
    {%- capture breadcrumb_items -%}{{ breadcrumb_items }},
{
  "@type": "ListItem",
  "position": 2,
  "name": {{ collection.title | json }},
  "item": {{ shop_url | append: collection.url | json }}
}
    {%- endcapture -%}
  {%- when 'product' -%}
    {%- assign show_breadcrumbs = true -%}
    {%- capture breadcrumb_items -%}{{ breadcrumb_items }},
{
  "@type": "ListItem",
  "position": 2,
  "name": {{ product.title | json }},
  "item": {{ shop_url | append: product.url | json }}
}
    {%- endcapture -%}
  {%- when 'page' -%}
    {%- assign show_breadcrumbs = true -%}
    {%- capture breadcrumb_items -%}{{ breadcrumb_items }},
{
  "@type": "ListItem",
  "position": 2,
  "name": {{ page.title | json }},
  "item": {{ shop_url | append: page.url | json }}
}
    {%- endcapture -%}
  {%- when 'blog' -%}
    {%- assign show_breadcrumbs = true -%}
    {%- capture breadcrumb_items -%}{{ breadcrumb_items }},
{
  "@type": "ListItem",
  "position": 2,
  "name": {{ blog.title | json }},
  "item": {{ shop_url | append: blog.url | json }}
}
    {%- endcapture -%}
  {%- when 'article' -%}
    {%- assign show_breadcrumbs = true -%}
    {%- capture breadcrumb_items -%}{{ breadcrumb_items }},
{
  "@type": "ListItem",
  "position": 2,
  "name": {{ blog.title | json }},
  "item": {{ shop_url | append: blog.url | json }}
},
{
  "@type": "ListItem",
  "position": 3,
  "name": {{ article.title | json }},
  "item": {{ shop_url | append: article.url | json }}
}
    {%- endcapture -%}
{%- endcase -%}

{%- if show_breadcrumbs -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [{{ breadcrumb_items | strip_newlines }}]
}
</script>
{%- endif -%}

{%- if request.page_type == 'article' and article -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": {{ shop_url | append: article.url | json }}
  },
  "headline": {{ article.title | json }},
  "description": {{ article.excerpt_or_content | strip_html | strip_newlines | truncate: 160 | json }},
  {% if article.image %}
  "image": [{{ article.image | image_url: width: 2000 | json }}],
  {% endif %}
  "datePublished": {{ article.published_at | date: "%Y-%m-%dT%H:%M:%S%z" | json }},
  "dateModified": {{ article.updated_at | date: "%Y-%m-%dT%H:%M:%S%z" | json }},
  "author": {
    "@type": "Person",
    "name": {{ article.author | json }}
  },
  "publisher": {
    "@type": "Organization",
    "name": {{ shop.name | json }}{% if logo_image %},
    "logo": {
      "@type": "ImageObject",
      "url": {{ logo_image | image_url: width: 600 | json }}
    }{% endif %}
  }
}
</script>
{%- endif -%}
