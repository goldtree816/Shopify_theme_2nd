<section class="aevi-feature {% if layout == 'image-right' %}reverse{% endif %}">
  <div class="aevi-container">
    <div class="aevi-image">
      {% if feature_image != blank %}
        <img src="{{ feature_image | img_url: 'master' }}" alt="Feature Image">
      {% endif %}
    </div>

    <div class="aevi-content">
      <h2>{{ heading }}</h2>
      <div class="aevi-description">
        {{ description }}
      </div>

      {% if button_text != blank %}
        <a href="{{ button_link }}" class="aevi-btn">{{ button_text }}</a>
      {% endif %}
    </div>
  </div>
</section>


<style>
.aevi-feature {
  width: 100%;
  padding: 80px 0;
}

.aevi-container {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 40px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 80px;
}

/* Reverse layout */
.aevi-feature.reverse .aevi-container {
  flex-direction: row-reverse;
}

/* IMAGE */
.aevi-image {
  flex: 0 0 50%;
  aspect-ratio: 1 / 1;
  overflow: hidden;
}

.aevi-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* CONTENT */
.aevi-content {
  flex: 0 0 50%;
  max-width: 520px;
  padding: 0;
}

.aevi-content h2 {
  font-size: 48px;
  font-weight: 400;
  margin-bottom: 16px;
  line-height: 1.05;
}

.aevi-description p {
  font-size: 14px;
  line-height: 1.6;
  letter-spacing: -0.3px;
  margin: 0;
  max-width: 420px;
}

.aevi-btn {
  display: inline-block;
  margin-top: 20px;
  font-size: 14px;
  text-decoration: underline;
  color: #000;
}

/* TABLET */
@media (max-width: 1024px) {
  .aevi-container {
    gap: 48px;
    padding: 0 24px;
  }

  .aevi-content h2 {
    font-size: 40px;
  }
}

/* MOBILE */
@media (max-width: 768px) {
  .aevi-container {
    flex-direction: column !important;
    gap: 32px;
    padding: 0 16px;
  }

  .aevi-image {
    width: 100%;
    aspect-ratio: 1 / 1;
  }

  .aevi-content {
    width: 100%;
    max-width: 100%;
  }

  .aevi-content h2 {
    font-size: 30px;
  }

  .aevi-description p {
    max-width: 100%;
  }
}

</style>

