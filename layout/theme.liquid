<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ 'component-product-card.css' | asset_url | stylesheet_tag }}

    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% # Load and preload the critical CSS %}
    {{ 'aevi.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'drawers.css' | asset_url | stylesheet_tag }}
    {{ 'cart-drawer.css' | asset_url | stylesheet_tag }}
    {{ 'section-sidebar_menu.css' | asset_url | stylesheet_tag }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>
  <body class="template-{{ template.name | handle }}{% if template.suffix != blank %} template-{{ template.name | handle }}-{{ template.suffix | handle }}{% endif %}">
    {% sections 'header-group' %}
    {% section 'search-overlay' %}
    <div class="pageOverlay" aria-hidden="true"></div>

    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
    {% render 'drawer' %}

    {% unless template.name == 'cart' %}
      {% render 'cart-drawer', mode: 'drawer' %}
    {% endunless %}


<!-- PRODUCT CARD DRAWER START -->
<product-card-drawer
  id="product-card__drawer"
  class="Drawer--wrapper drawer-bottom"
  aria-expanded="false"
  aria-hidden="true"
>
  <div class="Drawer--Wrapper">
    <button type="button" class="Drawer--Close" data-action="close-drawer" data-toggle-id="product-card__drawer" aria-label="Close">
      &times;
    </button>
    <div class="Drawer--Content product-card__drawer--content" data-scrollable></div>
  </div>
</product-card-drawer>
<!-- PRODUCT CARD DRAWER END -->

{{ 'drawers.js' | asset_url | script_tag }}
{{ 'cart-drawer.js' | asset_url | script_tag }}
<script>

document.addEventListener("change", function(e) {
  const select = e.target.closest("[data-product-card-variant-select]");
  if (!select) return;

  const scope = select.closest(".product-card__purchase-options, .product-card__information-bottom-half");
  if (!scope) return;

  const btn = scope.querySelector(".quick-add-btn");
  if (!btn) return;

  const selectedOption = select.options[select.selectedIndex];
  const variantId = select.value;
  const isAvailable = selectedOption ? selectedOption.dataset.available !== "false" : true;
  const addLabel = btn.dataset.addLabel || "ADD TO BAG";
  const soldLabel = btn.dataset.soldLabel || "SOLD OUT";
  const productCard = select.closest(".product-card");

  btn.dataset.variant = variantId;
  btn.disabled = !isAvailable;

  const textNode = btn.querySelector(".ButtonText");
  if (textNode) {
    textNode.textContent = isAvailable ? addLabel : soldLabel;
  }

  if (productCard && selectedOption) {
    const priceNode = productCard.querySelector("[data-product-card-price]");
    const compareWrap = productCard.querySelector("[data-product-card-compare-wrap]");
    const compareNode = productCard.querySelector("[data-product-card-compare-price]");

    if (priceNode && selectedOption.dataset.price) {
      priceNode.textContent = selectedOption.dataset.price;
    }

    if (compareWrap && compareNode) {
      const compareRaw = Number(selectedOption.dataset.comparePriceRaw || 0);
      const regularRaw = Number(selectedOption.dataset.priceRaw || 0);
      const compareMoney = selectedOption.dataset.comparePrice || "";

      if (compareRaw > regularRaw) {
        compareNode.textContent = compareMoney;
        compareWrap.classList.remove("product-card__price-compare--hidden");
      } else {
        compareNode.textContent = "";
        compareWrap.classList.add("product-card__price-compare--hidden");
      }
    }
  }
});

document.addEventListener("click", function(e) {
  const btn = e.target.closest(".quick-add-btn");
  if (!btn) return;

  e.preventDefault();
  e.stopPropagation();

  if (btn.disabled) return;

  const id = btn.dataset.variant;
  if (!id) return;

  fetch("/cart/add.js", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      id: Number(id),
      quantity: 1
    })
  })
  .then(res => res.json())
  .then(() => {
    document.dispatchEvent(new CustomEvent("cart:updated"));
  })
  .catch(err => console.error("Quick add error:", err));
});

</script>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const overlays = Array.from(document.querySelectorAll(".localizationOverlay"));
  let activeSelectbox = null;

  const getContent = (selectbox) => selectbox?.querySelector(".RevolutionSelectbox--Content");
  const getButton = (selectbox) => selectbox?.querySelector(".RevolutionSelectbox--Button");

  const setOverlayVisible = (visible) => {
    overlays.forEach((overlay) => {
      overlay.classList.toggle("is-visible", visible);
      overlay.setAttribute("aria-hidden", visible ? "false" : "true");
    });
  };

  const closeSelectbox = (selectbox) => {
    const content = getContent(selectbox);
    const button = getButton(selectbox);
    if (!content || !button) return;
    content.setAttribute("aria-hidden", "true");
    content.setAttribute("aria-expanded", "false");
    button.setAttribute("aria-expanded", "false");
    setOverlayVisible(false);
    activeSelectbox = null;
  };

  const openSelectbox = (selectbox) => {
    if (!selectbox) return;
    if (activeSelectbox && activeSelectbox !== selectbox) {
      closeSelectbox(activeSelectbox);
    }
    const content = getContent(selectbox);
    const button = getButton(selectbox);
    if (!content || !button) return;
    content.setAttribute("aria-hidden", "false");
    content.setAttribute("aria-expanded", "true");
    button.setAttribute("aria-expanded", "true");
    if (content.classList.contains("PopoverContent")) {
      setOverlayVisible(true);
    }
    activeSelectbox = selectbox;
  };

  const toggleSelectbox = (selectbox) => {
    const content = getContent(selectbox);
    if (!content) return;
    const isOpen = content.getAttribute("aria-hidden") === "false";
    if (isOpen) {
      closeSelectbox(selectbox);
    } else {
      openSelectbox(selectbox);
    }
  };

  document.addEventListener("click", (event) => {
    const toggle = event.target.closest('[data-action="toggle-selectbox"]');
    if (toggle) {
      event.preventDefault();
      toggleSelectbox(toggle.closest(".RevolutionSelectbox"));
      return;
    }

    const item = event.target.closest('[data-action="selectbox-submit"]');
    if (item) {
      event.preventDefault();
      const selectbox = item.closest(".RevolutionSelectbox");
      const form = selectbox?.querySelector("form.shopify-localization-form");
      const selectName = selectbox?.getAttribute("data-select");
      const input = form?.querySelector(`[name="${selectName}"]`);
      const value = item.getAttribute("data-value");
      const display = item.getAttribute("data-name") || item.textContent?.trim();

      if (selectbox) {
        const title = selectbox.querySelector(".RevolutionSelectbox--Title");
        if (title && display) title.textContent = display;
        selectbox.querySelectorAll(".RevolutionSelectbox--Item[selected=\"selected\"]").forEach((node) => {
          node.removeAttribute("selected");
        });
        item.setAttribute("selected", "selected");
      }

      if (input && value) {
        input.value = value;
        form.submit();
      }
      closeSelectbox(selectbox);
      return;
    }

    if (activeSelectbox && !event.target.closest(".RevolutionSelectbox")) {
      closeSelectbox(activeSelectbox);
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && activeSelectbox) {
      closeSelectbox(activeSelectbox);
    }
  });

  overlays.forEach((overlay) => {
    overlay.addEventListener("click", () => {
      if (activeSelectbox) closeSelectbox(activeSelectbox);
    });
  });
});
</script>
  </body>
</html>





